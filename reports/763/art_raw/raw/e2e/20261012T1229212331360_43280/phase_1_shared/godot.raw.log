[Load] lv=4 gold=300 flags={ "boss_killed_heukrang_gul": true, "opening_pending": false, "quest": { "beomgul_seal": { "state": "accepted" }, "bongmil_gate": { "state": "accepted" }, "heukrang_clear": { "state": "done", "left": 0, "barked": true }, "heukrang_seal": { "state": "done" }, "heukrang_thanks": { "state": "done" }, "soeburi_seal": { "state": "accepted" } }, "quest_log": { "history": { "heukrang_clear": [{ "name": "촌장", "source": "npc/elder", "speaker": "elder", "static_id": "NPC_ELDER_OFFER_1", "text": "부탁이 하나 있소. 흑랑 굴 말이오.", "uid": "npc/elder/NPC_ELDER_OFFER_1" }, { "name": "촌장", "source": "npc/elder", "speaker": "elder", "static_id": "NPC_ELDER_OFFER_2", "text": "밤마다 어귀에서 것들이 기어 나와 밭을 헤집고 외양간을 비우오.", "uid": "npc/elder/NPC_ELDER_OFFER_2" }, { "name": "촌장", "source": "npc/elder", "speaker": "elder", "static_id": "NPC_ELDER_OFFER_3", "text": "끝까지는 바라지도 않소. 첫 층만… 비워 주시오.", "uid": "npc/elder/NPC_ELDER_OFFER_3" }, { "name": "도호", "source": "npc/elder", "speaker": "doho", "static_id": "NPC_ELDER_OFFER_4", "text": "첫 층만? 그럼 산책이구먼.", "uid": "npc/elder/NPC_ELDER_OFFER_4" }, { "name": "촌장", "source": "npc/elder", "speaker": "elder", "static_id": "NPC_ELDER_ACCEPT_1", "text": "그 산책, 부디 무사히 끝내시오.", "uid": "npc/elder/NPC_ELDER_ACCEPT_1" }, { "name": "촌장", "source": "npc/elder", "speaker": "elder", "static_id": "NPC_ELDER_CLEAR_DONE_1", "text": "간밤엔 굴 쪽이 조용했소. …도사 양반 솜씨요?", "uid": "npc/elder/NPC_ELDER_CLEAR_DONE_1" }, { "name": "도호", "source": "npc/elder", "speaker": "doho", "static_id": "NPC_ELDER_CLEAR_DONE_2", "text": "산책 좀 했지.", "uid": "npc/elder/NPC_ELDER_CLEAR_DONE_2" }, { "name": "촌장", "source": "npc/elder", "speaker": "elder", "static_id": "NPC_ELDER_REPORT_1", "text": "몇 해 전 묵어 간 도사가 두고 간 책이 한 권 있소. 우리 집안은 까막눈이라…", "uid": "npc/elder/NPC_ELDER_REPORT_1" }], "heukrang_seal": [{ "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_1", "text": "그나저나 도사 양반, 이 장터가 왜 닫혔는지는 아시우?", "uid": "npc/jumo/NPC_JUMO_MAIN_1" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_2", "text": "봉인이 무너져서 괴질이 돈다는 건 대충 들었지.", "uid": "npc/jumo/NPC_JUMO_MAIN_2" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_3", "text": "마을 북쪽 산길 끝에 봉밀굴 문 있잖우. 돌문 말이우.", "uid": "npc/jumo/NPC_JUMO_MAIN_3" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_3B", "text": "그 문 열쇠가 세 조각으로 쪼개져서, 굴마다 하나씩 박혀 있다우.", "uid": "npc/jumo/NPC_JUMO_MAIN_3B" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_3C", "text": "개가 하나, 들녘 흑랑 굴이우. 범이 하나, 고개 너머 범굴이우.", "uid": "npc/jumo/NPC_JUMO_MAIN_3C" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_4", "text": "소문치곤 번지수까지 친절하구먼.", "uid": "npc/jumo/NPC_JUMO_MAIN_4" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_4B", "text": "쇠 먹는 놈 뱃속에 하나는, 같은 고개 너머 쇠부리 폐광이우.", "uid": "npc/jumo/NPC_JUMO_MAIN_4B" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_5", "text": "목로에 앉아 있으면 소문이 다 들어오우. 값은 국물에 쳐서 받지.", "uid": "npc/jumo/NPC_JUMO_MAIN_5" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_6", "text": "열쇠를 모아 문을 열어야 이 병의 뿌리를 뽑을 수 있고, 뿌리를 뽑아야 닫힌 장터가 다시 열리지.", "uid": "npc/jumo/NPC_JUMO_MAIN_6" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_7", "text": "뿌리라… 구미호 말이지.", "uid": "npc/jumo/NPC_JUMO_MAIN_7" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_8", "text": "…그 이름은 내 입에 올리기 싫수. 국물 식겠수.", "uid": "npc/jumo/NPC_JUMO_MAIN_8" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_9", "text": "국물값치곤 일이 크네. 외상으로 달아 두시오.", "uid": "npc/jumo/NPC_JUMO_MAIN_9" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_1", "text": "벌써 하나 가져오셨수? 그게 열쇠우? 어디 좀…", "uid": "npc/jumo/NPC_JUMO_NEWS1_1" }, { "name": "", "source": "npc/jumo", "speaker": "", "static_id": "NPC_JUMO_NEWS1_2", "text": "조각으로 뻗던 주모의 손이 허공에서 멈춘다.", "uid": "npc/jumo/NPC_JUMO_NEWS1_2" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_3", "text": "에구, 나이 드니 손이 시려서. 도사 양반이 들고 계시우.", "uid": "npc/jumo/NPC_JUMO_NEWS1_3" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_NEWS1_4", "text": "국물 한 그릇이면 들고 다니지.", "uid": "npc/jumo/NPC_JUMO_NEWS1_4" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_HEUK", "text": "그 개는… 편히 갔수? …아니우, 괜한 소릴.", "uid": "npc/jumo/NPC_JUMO_NEWS1_HEUK" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_LEFT_BEOM_SOE", "text": "남은 둘은 고개 너머 정령재에 있수. 범굴이랑 쇠부리 폐광이우. 어느 쪽이 먼저든 상관없지.", "uid": "npc/jumo/NPC_JUMO_NEWS1_LEFT_BEOM_SOE" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_NEWS1_END", "text": "외상이 자꾸 느는구먼. 갚을 날이 오긴 하려나.", "uid": "npc/jumo/NPC_JUMO_NEWS1_END" }] }, "read": {  }, "revisions": { "heukrang_clear": 8.0, "heukrang_seal": 19.0 } }, "seen": { "npc/elder/start": 6.0, "npc/jumo/start": 1.0 }, "story": { "elder_after_heukrang": true, "elder_met": true, "elder_vouch_jumo": true, "entered/heukrang_gul": true, "entered/motgol": true, "jumo_met": true, "jumo_seals": 1.0, "roll/elder_greet": 2.0 } } portal=<null> wps=[]
