shaman/NPC_SHAMAN_DONE_2" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_DONE_3", "text": "봉인 기운이 달라졌소. 고맙소, 도사 양반.", "uid": "npc/shaman/NPC_SHAMAN_DONE_3" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_REPORT_1", "text": "봉인 첫 자락은 다시 여몄소. 한동안은 버틸 거요.", "uid": "npc/shaman/NPC_SHAMAN_REPORT_1" }] }, "read": { "heukrang_seal": "done/13" }, "revisions": { "heukrang_seal": 13.0 } }, "seen": { "npc/shaman/start": 2.0 }, "story": { "shaman_heal_intro": true, "shaman_offer": true } } portal=<null> wps=[]
