R_8", "speaker": "shaman", "name": "무당 할매", "text": "살아서 돌아오면 쳐 드리리다." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_9", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_9", "speaker": "doho", "name": "도호", "text": "…허. 하는 김에." }] }, "revisions": { "heukrang_seal": 11 } }, "quest": { "heukrang_clear": { "state": "none", "left": 20, "barked": false }, "heukrang_seal": { "state": "killed" }, "heukrang_thanks": { "state": "killed" } }, "seal:boss_heukrang": 1, "boss_killed_heukrang_gul": true }
