class_name Boss
extends Enemy
## Boss — 흑랑(구미호의 수하). Enemy 상태머신 위에 돌격(주기)·2페이즈(속도·소환)·보장 드랍만 덧붙인다. 사양 design/boss_save_v2.md.
## 왜 상속인가: 피격·사망·길찾기·근접 공격은 Enemy 그대로 쓰고, 다른 점은 세 가지뿐. 보스가 늘면(EA 구미호) 페이즈 표를 데이터로 뺀다.
## 다른 보스가 덮는 이음매 (장산범 #494 — actors/boss_jangsanbeom.gd): 페이즈 문턱 _tick_phase · 돌격을 걸까 _wants_charge · 처치 알림 _death_line ·
## 보장 엽전 _boss_coins. 보스 무리(「boss」) 밖에 선 같은 몸(장산범 허상)은 처치 표시·封·먹 스러짐을 건너뛴다(_die · _start_corpse).

const CHARGE_COOLDOWN := 6.0
const CHARGE_WINDUP := 0.5
const PHASE2_RATIO := 0.5
const PHASE2_SPEED := 1.3
const SUMMON_COUNT := 2   # 3 → 2 (combat_v2 §7 1차 튠: 3층 박쥐 3마리는 자동공격만 쓰는 플레이어에게 전멸 스파이크)
const SUMMON_DEF := preload("res://data/enemies/bat.tres")
const ENEMY_SCENE := preload("res://actors/enemy.tscn")

## 이 보스가 지키는 지역 (D-077) — 처치 플래그 `boss_killed_<지역>` (bosses_v2 §6: 다음 던전 입구·봉인 조각은 #167~#169).
@export var area_id: StringName = &""

var _charge_cd: float = 2.0
var _charging: bool = false
var _phase2: bool = false
var _intro_sent: bool = false


func _ready() -> void:
	rank = EliteRules.Rank.BOSS   # 등급 (monsters_v2 §6.5 · §13.7, #290) — 보스는 레벨 가산 0 · 배수 1(보스마다 튠)
	super._ready()
	add_to_group("boss")   # 생명 = HUD 보스 바 (머리 위 숫자는 어느 적에도 없다 — #382)


func _physics_process(delta: float) -> void:
	if TRACE.enabled():
		TRACE.event("boss_physics", "Boss._physics_process", self, {"delta": TRACE.exact(delta)})
	# #96: 실제 조우 거리에서 한 번만 컷인을 청한다. UI·일시정지는 영속 셸이 맡는다.
	if is_in_group("boss") and not _intro_sent and state != State.DEAD:
		var player_in_world := get_tree().get_first_node_in_group("player") as Node3D
		if player_in_world and player_in_world.global_position.distance_squared_to(global_position) <= 121.0:
			_intro_sent = true
			EventBus.boss_spotted.emit(self)
		if get_tree().paused:
			return
	if state != State.DEAD:
		_charge_cd = maxf(0.0, _charge_cd - delta)
		_tick_phase()
	super._physics_process(delta)


## 페이즈 문턱 (흑랑 = 생명 50%에 2페이즈 한 번). 제 페이즈 표를 가진 보스가 덮는다(장산범 60 · 30 — #494).
func _tick_phase() -> void:
	if not _phase2 and hp <= max_hp * PHASE2_RATIO:
		_enter_phase2()


## 근접 추적 + 거리 3~9에서 돌격 준비.
func _tick_chase(delta: float, dist: float, to_player: Vector3) -> void:
	if _wants_charge(dist):
		_charging = true
		state = State.WINDUP
		_state_timer = CHARGE_WINDUP * _atk_mult()   # 한기면 돌격 준비도 길다 (보스판 ×1.1, E2 #202)
		velocity.x = 0.0
		velocity.z = 0.0
		DamagePopup.spawn(get_parent(), global_position, "!!", Color(1.0, 0.4, 0.3), true)
		_visual.play_pounce(_state_timer)   # 웅크림 → 선딜 끝에 뛰어오름 → 돌진 = 뜬 몸 → 착지 (#506 — 돌격 연출은 그대로, 동작만. 클립 없는 몸은 옛 그대로)
		return
	super._tick_chase(delta, dist, to_player)


## 돌격 준비를 걸까 — 흑랑 = 쿨이 돌았고 거리 3~9. 제 돌진을 따로 쥔 보스(장산범 덮치기 #494)는 false로 덮는다.
func _wants_charge(dist: float) -> bool:
	return _charge_cd <= 0.0 and dist >= def.keep_distance_min and dist <= def.keep_distance_max


func _do_attack(to_player: Vector3) -> void:
	if _charging:
		_charging = false
		_charge_cd = CHARGE_COOLDOWN * _atk_mult()
		_dash_dir = to_player.normalized()
		_dash_left = def.dash_length
		_dash_hit = false
		state = State.DASH
		Vfx.play("enemy_dash", global_position, {"dir": -_dash_dir, "scale": 1.4})
		return
	super._do_attack(to_player)


## 한기 보스판 (D-081 §3.3, E2 #202): 이동 ×0.85 · 공격 ×1.1 — 약하게 · 한기 시간 절반(PD 2026-09-23, StatusEffects.CHILL_TIME_MULTS).
## 얼지는 않는다(.tres can_freeze = false → 빙결 요청 = 한기 두 배 × 절반 = 빙결 시간 그대로).
func _status_kind() -> int:
	return STATUS.Kind.ELITE


## 돌격 준비가 끊기면 다음 선딜이 돌격으로 새지 않게 (보스는 얼지 않지만 _cancel_attack의 계약을 지킨다).
func _cancel_attack() -> void:
	super._cancel_attack()
	_charging = false


## 2페이즈 = speed_mult 1.3 (덮어쓴다) — 한기는 Enemy._move_mult가 따로 곱하니 섞이지 않는다.
func _enter_phase2() -> void:
	_phase2 = true
	speed_mult = PHASE2_SPEED
	var mat := _body_mesh.material_override as StandardMaterial3D
	if mat:
		mat.emission_enabled = true
		mat.emission = Color(0.8, 0.15, 0.1)
		mat.emission_energy_multiplier = 0.8
	Audio.play("boss_roar", global_position)
	Vfx.play("boss_roar", global_position + Vector3(0, 0.8, 0))
	var cam := get_viewport().get_camera_3d()
	if cam and cam.has_method("kick"):
		cam.kick(0.2)   # 포효 = 치명 킥(0.09)의 두 배 (vfx.md #47)
	EventBus.ui_message.emit("흑랑이 울부짖는다 — 박쥐 떼!")
	for i in SUMMON_COUNT:
		var e := ENEMY_SCENE.instantiate()
		e.def = SUMMON_DEF
		e.area_level = area_level
		get_parent().add_child(e)
		var ang := TAU * float(i) / float(SUMMON_COUNT)
		e.global_position = global_position + Vector3(cos(ang), 0.0, sin(ang)) * 2.0
		e.state = State.CHASE
		Vfx.play("boss_summon", e.global_position + Vector3(0, 0.5, 0))


## 보장 드랍: 매직 이상 장비 2 + 보스 전용 유니크(첫 처치 보장) + 엽전 100+ (일반 드랍은 super). 원천 = 보스(EnemyDef.drop_class) →
## 좋은 물건 ×5 · 아이템 레벨 +3 (item_system_v2 §6.3 — 흑랑 = 지역 3 + 3 = 6). 「매직 이상」 = ctx min_grade (옛 「보통이면 매직으로 고쳐 굴림」 자리).
func _drop_loot() -> void:
	super._drop_loot()
	var ctx := drop_ctx()
	ctx["min_grade"] = ItemInstance.Rarity.MAGIC
	for i in 2:
		var it := ItemGen.roll_item(_rng, Loot.item_level(ctx), ctx)
		if it:
			EventBus.loot_dropped.emit(it, global_position + Vector3(0.0, def.height * 0.55, 0.0))
	_drop_boss_unique(ctx)
	_drop_seal()
	EventBus.loot_dropped.emit(ItemInstance.create(ItemDb.get_def("coin"), _boss_coins()), global_position + Vector3(0.0, def.height * 0.55, 0.0))


## 보장 엽전 (item_system_v2 §15 표 — 흑랑 100 + 30 × 지역 · 장산범 150 + 40 × 지역, bosses_v2의 「층」을 지역으로). 보스마다 덮는다.
func _boss_coins() -> int:
	return 100 + 30 * area_level


## 봉인 조각 (item_system_v2 §14.4·§14.5, I12 #268): 회차마다 첫 처치 — 보스 전용 유니크(캐릭터 평생 1회)와 다른 축이라 GameState.flags에
## 따로 적는다("seal:<적 id>" = 받은 회차, field_level.gd 자리 물건과 같은 결). def.seal_item이 없거나(불가살이 = 데이터만 — 장산범 봉인고리는 #494) 이미 이번
## 회차에 받았으면 아무 일 없다.
func _drop_seal() -> void:
	if def.seal_item == &"":
		return
	var key := "seal:%s" % def.id
	if not Loot.seal_pending(int(GameState.flags.get(key, 0)), GameState.run):
		return
	var d := ItemDb.get_def(String(def.seal_item))
	if d == null:
		return
	GameState.flags[key] = GameState.run
	EventBus.loot_dropped.emit(ItemInstance.create(d), global_position + Vector3(0.0, def.height * 0.55, 0.0))


## 보스 전용 유니크 (item_system_v2 §6.3 · §8.3, I7 #263): 이 캐릭터의 첫 처치면 반드시(흑랑 = 흑랑 송곳니 — 슬라이스 끝, 모두의 첫 유니크),
## 그 뒤로는 1회차 15% · 2회차 20%. 첫 처치 기록 = GameState.first_kills(세이브 칸) — 굴린 뒤에 적는다(이번 처치가 첫 처치로 읽히게).
func _drop_boss_unique(ctx: Dictionary) -> void:
	var first := GameState.first_kill_pending(def.id)
	var u := Loot.boss_unique_drop(_rng, def.id, ctx, first)
	GameState.note_first_kill(def.id)
	if u:
		EventBus.loot_dropped.emit(u, global_position + Vector3(0.0, def.height * 0.55, 0.0))
	if DevMode.is_active:
		print("[Loot] 보스 전용 유니크 — %s %s → %s (회차 %d)" % [def.id, "첫 처치" if first else "재처치", u.unique_id if u else "없음", GameState.run])


func _die() -> void:
	super._die()
	# 보스 무리 밖에 선 같은 몸(장산범 허상 #494 — 경험치·드랍 0은 gives_reward가 이미 막았다)은 여기까지: 封·퀘스트·처치 표시·저장·알림 없음
	if not is_in_group("boss"):
		return
	Vfx.play("boss_die", global_position)
	Quest.on_boss_killed(GameState.flags, def.id)   # 이 적을 노리는 퀘스트 전부 — 흑랑 = 할매 퀘스트 1 + 촌장 사례 (npcs_v2 §5.6, #305)
	GameState.flags[Quest.den_flag(String(area_id))] = true   # 처치 표시 boss_killed_<지역> — 입구·진열·할매 봉인 조각 소식(Quest.seals, #171)이 읽는다
	# 보스 처치 스킬 포인트 (skills_v2 §4.1 — 회차마다 한 번, 흑랑 0 = 촌장 의뢰가 준다) — 처치 신호(저장)보다 먼저
	var pts := Progression.grant_skill_points(GameState.character, def.kill_skill_points, "boss/" + def.id, GameState.run)
	EventBus.boss_died.emit(self)
	# 알림 = 시간차 두 줄 (#494 — 막타 숫자 · 목소리 · 도호 바크와 한 자리에 포개져 못 읽었다): 막타 숫자가 사라진 뒤 처치 한 줄 → 그 줄이 진 뒤 스킬 포인트
	_announce_later(_death_line(), DEATH_LINE_DELAY)
	if pts > 0:
		_announce_later("스킬 포인트 +%d" % pts, DEATH_LINE_DELAY + DEATH_LINE_SEC + 0.1)
	if DevMode.is_active:
		print("[Boss] killed area=%s level=%d flags=%s" % [area_id, area_level, GameState.flags])


## 처치 알림 한 줄 — 보스마다 덮는다(장산범 「목소리가 그쳤다.」 bosses_v2 §2.4 · 불가살이 「쇠 씹는 소리가 그쳤다.」). 흑랑 = 제 굴의 주인(D-077).
## 셋 다 같은 틀 = 마침표로 끝나는 한 문장 · 다음 걸음은 안 말한다(#546 대본 점검 C H-8·B-8 — 옛 흑랑 줄만 「— 못골에 알리자」가 붙어 결이 달랐다.
## 보고 길은 의뢰 기록(Q)·「의뢰에 새 소식」이 알린다).
func _death_line() -> String:
	return "흑랑 굴의 주인이 쓰러졌다."


## 처치 알림 시간표 (#494): 막타 숫자(DamagePopup 처치 일격 — 0.62초 궤적)가 사라진 뒤 첫 줄 · 한 줄 머무는 시간(읽히게 늘림 — DamagePopup.linger) · 둘째 줄은 첫 줄이 진 뒤.
const DEATH_LINE_DELAY := 0.8
const DEATH_LINE_SEC := 1.6


## sec초 뒤 알림 한 줄 (EventBus.ui_message → 도호 머리 위) · 읽히게 DEATH_LINE_SEC 머물게. 시체가 남아 있는 동안(8초)이라 몸 타이머로 충분하다 —
## 그 전에 층을 떠나면(몸이 풀림) 알림도 없다.
func _announce_later(text: String, sec: float) -> void:
	if text == "" or not is_inside_tree():
		return
	get_tree().create_timer(sec, false).timeout.connect(_announce.bind(text))


func _announce(text: String) -> void:
	EventBus.ui_message.emit(text)
	var l := DamagePopup.last()   # 방금 셸(Main._on_ui_message)이 띄운 머리 위 글 — 셸이 없는 장면(단위 시험)이면 다른 팝업일 수 있어 글자로 확인
	if l != null and l.text == text:
		DamagePopup.linger(l, DEATH_LINE_SEC)


# ---------- 먹으로 스러짐 (보드 #281, D-085 · design/vfx.md §8.11) ----------
## 흑랑은 제 연출(D-080): 제자리에 쓰러진 몸이 막타 DISSOLVE_FROM초부터 DISSOLVE_SEC초 동안 먹으로 스러지고, 그 밑에 써 둔 흰 먹 封(Vfx `boss_die`,
## 0.25초부터)이 드러난다. 시체 시간표(Enemy — die 클립 → 8초 누움 → 가라앉음)는 그대로 돈다: 다 스러진 뒤엔 몸만 숨긴다(시체 수·누움 상태·자리는 같다).
const INK_DISSOLVE := preload("res://actors/ink_dissolve.gd")
const DISSOLVE_FROM := 0.85
const DISSOLVE_SEC := 0.45

## 지금 스러진 정도 (0 → INK_DISSOLVE.FULL 1.25) — e2e·dev가 읽는다.
var dissolve: float = 0.0
var _dissolve_mats: Array[ShaderMaterial] = []


func _start_corpse() -> void:
	super._start_corpse()
	if not is_in_group("boss"):
		return   # 보스 무리 밖 몸(장산범 허상 #494)은 제 죽음(먹물 흩어짐)만 — 먹 스러짐을 겹치지 않는다
	var tw := create_tween()
	tw.tween_interval(DISSOLVE_FROM)
	tw.tween_callback(_begin_dissolve)
	tw.tween_method(_set_dissolve, 0.0, 1.0, DISSOLVE_SEC)
	tw.tween_callback(_end_dissolve)


func _begin_dissolve() -> void:
	_dissolve_mats = INK_DISSOLVE.apply(_visual)


func _set_dissolve(u: float) -> void:
	dissolve = INK_DISSOLVE.amount(u)
	INK_DISSOLVE.set_amount(_dissolve_mats, dissolve)


func _end_dissolve() -> void:
	_set_dissolve(1.0)
	_visual.visible = false
