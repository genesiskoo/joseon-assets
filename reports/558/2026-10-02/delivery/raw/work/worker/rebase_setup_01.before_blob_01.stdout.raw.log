class_name ActorVisual
extends Node3D

const TRACE := preload("res://core/combat_trace.gd")
## ActorVisual — 배우의 `Visual` 노드. ModelDef가 가리키는 GLB가 있으면 인스턴스해 플레이스홀더(캡슐)를 숨기고,
## 없으면 플레이스홀더를 그대로 둔다. 애니 상태기(idle/walk 루프 + attack/hit 단발 + die)도 여기.
## 왜 이 구조인가(D-067 "코드는 아트를 기다리지 않는다"): 배우 스크립트(player/enemy/npc)는 "움직인다·때린다·맞았다·죽었다"만 알리고
## 클립 이름·스케일·정면 보정은 데이터(ModelDef)와 이 노드가 흡수한다. 대안 = 각 배우가 AnimationPlayer를 직접 다루기 →
## 모델마다 클립 이름이 달라(Meshy "Sword Slash", Tripo "preset:slash") 배우 코드가 아트에 끌려간다 → 기각.
## 사양 design/art_3d_pipeline.md §2.

## 변종 틴트 (#299 — monsters_v2 §3.3 「변종 = 이름 · 틴트 …」의 최소판, 영역 마스크 #196 전): 모델 재질 알베도에 곱한다(흰색 = 그대로).
## 배우가 apply_model 전에 넣는다(Enemy._apply_visual ← EnemyDef.model_tint). 같은 모델을 나눠 쓰는 가족 변종(소복 귀신 셋)이 색으로 갈린다.
## 옷자락 물결 몸(#502 — ModelDef.robe_wave)은 표면 덮기 복제 대신 물결 재질의 albedo에 곱한다(FloatMotion.body_material — 틴트·물결·겉칠이 한 재질).
var albedo_tint: Color = Color.WHITE
## (원래 재질, 틴트) → 물들인 사본. 재질은 같은 GLB를 쓰는 배우끼리 나눠 가지므로 원본을 고치지 않고 표면 덮기로 입히고, 같은 짝은 한 벌만 만든다.
static var _tinted: Dictionary = {}

## 동의어 — 생성 서비스마다 다른 프리셋 이름을 흡수 (§2.3). 순서 = 우선순위.
const SYNONYMS := {
	"idle": ["idle", "stand", "breath", "wait"],
	"walk": ["walk", "move", "locomot"],
	"run": ["run", "sprint", "jog"],
	"attack": ["attack", "slash", "punch", "kick", "bite", "cast", "shoot", "throw", "strike"],
	"hit": ["hit", "hurt", "damage", "impact", "react", "flinch"],
	"die": ["die", "death", "dying", "dead", "fall", "down", "defeat"],
}
## 걷기 판정 속도(유닛/초).
const MOVE_EPS := 0.2
## 클립 사이 블렌드(초).
const BLEND := 0.1
## 순환 평타가 끝난 뒤 대기로 넘어가기 전 유예(초, 보드 #141). 다음 휘두름은 공속 타이머(물리 틱)로 오고 끝남(_busy_until)은 이 시계로 재서,
## 같은 틱에 "대기 → 평타"가 이어질 수 있다 — 그때 대기가 무게 0으로 끼면 다음 평타가 나가기 섞기(ModelDef.chain_blend_out, 길다)를 물려받아
## 순환 안 섞기까지 길어진다(AnimationPlayer는 새 클립 섞기를 **앞 클립이 섞이던 시간**으로 푼다). 유예 동안은 대기로 안 간다.
## 채움(#471 ModelDef.swing_fill < 1)이면 휘두름이 간격보다 일찍 끝난다 — 유예 = 남는 틈(_swing_gap) + 이만큼(다음 휘두름 = 간격 뒤, 그때까지 끝 자세).
const CHAIN_GRACE := 0.1
## 매듭 클립(#471)의 검광 = 빠른 구간만 굵게 — 칼끝 속도(유닛/초)가 x 아래면 칼끝의 가는 선, y 위면 칼날 통째(SwordTrail.begin fast).
## 새 1타(motion_audit --trace, 모델 1유닛 = 1m): 감기 ≤ 16 · 장전 0 · 내려치기 64 → 최고 223 · 제동 83 → 22 — 감기·장전은 가늘게, 내려치기·제동 첫머리는 통째.
const TRAIL_FAST := Vector2(20.0, 60.0)

signal model_changed(loaded: bool)
## 발 디딤 (보드 #178, design/audio.md §2.2): 이동 클립의 재생 위치가 ModelDef.step_phases의 위상을 지난 순간. foot = 짝의 0·1번.
## 배우(Player)가 받아 발소리를 낸다 — 소리가 **보이는 발**에 붙어 재생 배율(= 속도)·걷기↔달리기 전환을 저절로 따라간다.
## 위상이 없는 모델은 쏘지 않는다(steps_synced() = false → 배우가 거리로 센다).
signal foot_down(foot: int)

@export var model: ModelDef

var moving: bool = false

var _model_root: Node3D
## 비행 부유용 (보드 #78)
var _def: ModelDef
var _hover_t: float = 0.0
var _anim: AnimationPlayer
## 부착 (#419): 무기 소켓·칼집·시전 손·옷 스프링·자락 펼침을 **만들어 붙이는** 코드는 actors/actor_attachments.gd(ActorAttachments) —
## 여기는 붙은 노드(_weapon·_sheathed·_cast_*)를 들고 클립에 맞춰 바꿔 끼운다. class_name 캐시 미스(AGENTS §8 함정 2)를 피해 preload 별칭.
## RobeFlare = 시험·도구가 `ActorVisual.RobeFlare`로 부르던 이름 그대로(별칭, 본체는 ActorAttachments.RobeFlare).
const ATTACH := preload("res://actors/actor_attachments.gd")
const RobeFlare := ATTACH.RobeFlare
## 떠다님 몸짓 (#502, monster_motion_v2 §3.4): 뼈 없는 떠다님 몸(ModelDef.float_active)의 코드 층 — 모델 뿌리 변환(기울기·덮치기·움찔)·흐려짐·
## 옷자락 물결 재질(틴트·겉칠 포함)을 actors/float_motion.gd가 쥔다. null = 옛 부유(_process — 박쥐·혼불). preload 별칭(AGENTS §8-2).
const FLOAT_MOTION := preload("res://actors/float_motion.gd")
var _float: FLOAT_MOTION = null
## 클립 다시 짜기 셈 (#503): 매듭 꺾은선·루프 이음새·디딤 발 잠금·단발 자르기 = actors/clip_remake.gd — 여기는 어느 클립에 무엇을 할지(remade_clip)만 고른다.
const CLIP := preload("res://actors/clip_remake.gd")
var _weapon: Node3D
## 칼집에 꽂힌 칼 (보드 #223, ModelDef.walk_blade = "sheath"): 손 칼과 같은 씬 한 벌. 걷기 클립(이벤트·컷씬용)이 도는 동안만 보이고 그동안 손 칼이 숨는다.
var _sheathed: Node3D
## 시전 손 (보드 #223, ModelDef.cast_clip): 시전 클립 동안만 손 뼈를 줄여 주먹을 숨기고 소품 손을 보인다.
var _cast_prop: Node3D
var _cast_talisman: Node3D
var _cast_sk: Skeleton3D
var _cast_bone: int = -1
var _cast_on: bool = false
var _cast_base_scale: float = 1.0
## 공격 클립 목록(attack, attack2, …) — play_attack / play_once("attack")이 무작위로 고른다(같은 클립 연속 금지, combat_v2 §6).
var _attack_clips: PackedStringArray = []
var _last_attack: String = ""
## 평타 순환 (보드 #141, combat_v2 §6.5): 쓸 수 있는 순서(ModelDef.attack_chain — 클립이 하나라도 없으면 비움 = 무작위) · 마지막으로 친 칸 ·
## 마지막 휘두름(평타·스킬)이 끝나는 시각 — 쉼은 **끝난 뒤**부터 잰다(공속이 느려도 이어 치면 순환이 안 끊긴다).
var _chain: PackedStringArray = []
var _chain_i: int = -1
var _swing_end: float = -INF
## 마지막 평타가 간격에서 남긴 틈(초, #471 채움) — 끝난 뒤 이만큼 + CHAIN_GRACE 동안 끝 자세로 선다(set_moving). 스킬·끊음·새 몸 = 0.
var _swing_gap: float = 0.0
## 마지막 play_attack이 순환 몇 번째 칸이었나(0부터, -1 = 무작위·세지 않은 휘두름) — PlayerCombat이 마지막 칸(3타)이면 넉백을 싣는다.
var last_chain_step: int = -1
## 평타 휘두름 수 · 마지막 클립 바꿈의 섞기(초) — 시험·뷰어가 본다.
var attack_swings: int = 0
var last_blend: float = 0.0
## 시계 (#141): 0 이상이면 이 시각(초)을 쓴다 — 뷰어 수동 촬영·시험이 정해진 시각으로 몬다(1.2초 쉼·대기 유예가 시계에 묶이지 않게). 음수 = 게임 시계(GameClock.now, #234).
var clock: float = -1.0
var _hitstop_token: int = 0
## 히트스톱 중(speed_scale 0). 그 사이 play()가 와도 멈춤을 유지한다 — 전에는 piggyback한 _play_name이 곧바로 1.0으로 되돌려 피격자 히트스톱이 사실상 0이었다(실측).
var _stopped: bool = false
var _flash_token: int = 0
## 피격 플래시 오버레이(공유). unshaded 흰색 반투명 — 플레이스홀더 캡슐에도 그대로 먹는다.
static var _flash_mat: StandardMaterial3D
static var _flash_full_mat: StandardMaterial3D
## 상태 틴트 (D-081 E2 #202, elements_v2 §6·§7.2) — 플래시와 같은 material_overlay 길. 플래시·깜빡임이 끝나면 null이 아니라 이 틴트로 돌아간다.
## null = 틴트 없음. 배우마다 한 벌(색이 다르다).
var _tint_mat: StandardMaterial3D
var _blink_mat: StandardMaterial3D
## 플래시·깜빡임이 덮고 있는 중 — 그 사이 바뀐 틴트는 끝날 때 입는다.
var _overlay_busy: bool = false
## 빙결 — 애니를 세운다(배율 0). 히트스톱이 풀려도 얼어 있는 동안은 0에 머문다. 날짐승 부유·날갯짓도 멈춘다.
var _anim_frozen: bool = false
## 동작 키 → 실제 클립 이름 (없으면 "").
var _clips: Dictionary = {}
var _placeholders: Array[Node] = []
## 단발 동작(attack/hit/die)이 끝나는 시각. 그 전엔 idle/walk로 덮어쓰지 않는다.
var _busy_until: float = 0.0
var _dead: bool = false
## 휘두름 (#424 — combat_v2 §9.2): 지금 휘두름(play_attack·play_skill)의 클립 · 그 클립 안 칼이 닿는 초 · 재생 배율 · 번호 · 휘두름 동작인가.
## _committed = 지금 _busy_until이 휘두름의 끝이다(피격·단발 클립이 busy를 잡으면 거짓) — swing_busy()가 이것으로 「동작 커밋」을 답한다.
var _swing_clip: String = ""
var _swing_hit: float = -1.0
var _swing_speed: float = 1.0
var _swing_no: int = 0
var _committed: bool = false
## 칼이 닿는 순간을 기다리는 표 (#424 ②) — [{no, at(클립 초), cb, cancel, late, done}]. 애니가 at을 지나는 틱(mixer_applied)에 cb를 부른다.
var _marks: Array = []
var _marks_anim: AnimationPlayer = null
## 휘두름 끝 판정 여유(초) — 게임 시계와 busy 끝이 부동소수로 한 틱 어긋나 동작이 한 틱 더 잠기지 않게.
const BUSY_EPS := 0.0005
## 자세를 고정해 둔 동안 (넘어진 산 몸 — pose_down/pose_end, §6.6 #145). 부유·날갯짓이 누운 자세를 덮지 않게.
var _posed: bool = false
var _current: String = ""
## 정지 자세 (보드 #91). 0 이상이면 idle 클립을 그 시각에 세워 두고 멈춘다 — 마을 사람은 두리번거리지 않는다.
var _idle_pose: float = -1.0
## 검광 리본 (design/vfx.md `sword_trail`, 보드 #46) — 무기가 있을 때만. 칼끝·밑동은 무기 메시 AABB(무기 로컬 +Y)에서 한 번 계산.
## class_name 캐시 미스(AGENTS §8 함정 2)를 피해 preload 별칭으로 만든다.
const SWORD_TRAIL := preload("res://actors/sword_trail.gd")
var _trail: MeshInstance3D
var _trail_tip: Vector3 = Vector3(0, 0.8, 0)
var _trail_base: Vector3 = Vector3(0, 0.25, 0)
## 발 디딤 추적 (#178). _steps_ready = 이 모델의 이동 클립 전부에 위상이 있다. _step_clip·_step_prev = 지난번에 본 이동 클립과 위상(0~1).
var _steps_ready: bool = false
var _step_clip: String = ""
var _step_prev: float = 0.0
## 클립을 처음부터 틀었을 때의 "직전 위상" — 0보다 조금 앞이라 위상 0에 적힌 디딤도 첫 틱에 잡힌다.
const STEP_FRESH := -0.000001
## 무기 칸 보이기/숨기기 (#430, PD 2026-09-24 「숨겨」 — equipment_slots_v2 §3.5·§4.7): 오른손 칸이 비거나 요구치 미달로
## 꺼지면(#427 StatsCalc.inactive) PlayerCombat._apply_to_player가 부른다 — 손 칼·칼집(_sync_swaps)과 검광 리본을 같이 끈다.
## 기본 켬 — 이 함수를 안 부르는 적·NPC는 늘 보인다(장비 칸 개념이 없다). 동작·피해 계산은 안 건드린다(칼 동작 그대로, #400).
var _weapon_active: bool = true


func _ready() -> void:
	if _model_root == null:
		apply_model(model)
	set_physics_process(_float != null)   # 물리 틱은 떠다님 몸(#502)만 — 엔진이 _ready 앞에서 켜 둔 것을 되돌린다


## 모델 교체. 성공(파일 있고 로드됨) 여부 반환. 실패 시 플레이스홀더가 보인다.
## 외곽선 두께(유닛, art_3d_pipeline §11 레버 4·보드 #15). 0이면 끔.
## 게임 카메라(ortho 11, 1유닛 ≈ 65px)에서 0.012유닛 ≈ 0.8px — 어두운 던전에서 실루엣이 바닥과 붙는 걸 막는 정도만.
const OUTLINE_WIDTH := 0.012
const OUTLINE_COLOR := Color(0.05, 0.045, 0.07)

func apply_model(def: ModelDef) -> bool:
	var node: Node3D = null
	if def != null and def.exists():
		var ps := load(def.scene_path) as PackedScene
		if ps:
			node = ps.instantiate() as Node3D
	return apply_node(node, def)


## 이미 인스턴스된 노드를 모델로 (뷰어가 GLTFDocument로 직접 읽은 GLB를 넘길 때). node=null이면 플레이스홀더.
func apply_node(node: Node3D, def: ModelDef) -> bool:
	model = def
	# 플레이스홀더 = 처음 호출 시점의 기존 자식들 (트리 밖에서 불려도 동작하도록 _ready에 의존하지 않는다)
	if _placeholders.is_empty():
		for c in get_children():
			if c != _model_root:
				_placeholders.append(c)
	if _model_root:
		_model_root.queue_free()
		_model_root = null
	_anim = null
	_sheathed = null
	_cast_prop = null
	_cast_talisman = null
	_cast_sk = null
	_cast_bone = -1
	_cast_on = false
	_clips.clear()
	_attack_clips.clear()
	_last_attack = ""
	_chain = PackedStringArray()
	_chain_i = -1
	_swing_end = -INF
	_swing_gap = 0.0
	last_chain_step = -1
	_steps_ready = false
	_step_clip = ""
	_float = null
	var loaded := false
	_model_root = node
	_def = def
	if _model_root and def:
		_model_root.name = "Model"
		add_child(_model_root)
		_model_root.scale = Vector3.ONE * def.scale
		_model_root.position.y = def.y_offset
		_model_root.rotation.y = deg_to_rad(def.yaw_offset_deg)
		_anim = _model_root.find_child("AnimationPlayer", true, false) as AnimationPlayer
		if _anim:
			for kind in SYNONYMS:
				_clips[kind] = resolve_anim(_anim.get_animation_list(), def.anim_name(kind), kind)
			# 대기 칼 안 B (#223): 대기 = `<대기>_out` 클립(있을 때만)
			if def.idle_blade == "out" and _clips.get("idle", "") != "" and _anim.has_animation(String(_clips.idle) + "_out"):
				_clips["idle"] = String(_clips.idle) + "_out"
			for kind in ["idle", "walk", "run"]:
				var n: String = _clips.get(kind, "")
				if n != "":
					_anim.get_animation(n).loop_mode = Animation.LOOP_LINEAR
			if _anim.has_animation(POUNCE_AIR):
				_anim.get_animation(POUNCE_AIR).loop_mode = Animation.LOOP_LINEAR   # 덮치기 뜬 몸 = 돌진 동안 되풀이 (#506)
			# 공격 다양화: 해석된 attack + 이름이 "attack"으로 시작하는 나머지 클립(attack2, attack_thrust…) — attack_solo(#299)면 주 공격 하나만
			var primary: String = _clips.get("attack", "")
			if primary != "":
				_attack_clips.append(primary)
			for n in _anim.get_animation_list():
				if not def.attack_solo and n != primary and n.to_lower().begins_with("attack"):
					_attack_clips.append(n)
			# 평타 순환 (#141): 순서 클립이 전부 있어야 켠다 — 하나라도 없으면 무작위로 둔다(반쯤 도는 순환보다 낫다)
			var missing := PackedStringArray()
			for c in def.attack_chain:
				if not _anim.has_animation(c):
					missing.append(c)
			if missing.is_empty():
				_chain = def.attack_chain.duplicate()
			else:
				push_warning("ActorVisual: %s attack_chain 클립 없음 %s — 평타는 무작위" % [def.id, missing])
			_apply_swing_warp(def)
			# 발 디딤 (#178): 애니가 한 번 돌 때마다(mixer_applied) 위상을 본다 — _process보다 한 프레임 늦지 않고, 테스트의 advance()에도 같이 돈다
			_steps_ready = _has_step_phases(def)
			if _steps_ready:
				_anim.mixer_applied.connect(_on_mixer_applied)
		if not def.keep_emission:
			strip_baked_emission(_model_root)
		if def.pixel_filter:
			_apply_pixel_filter(_model_root)
		if OUTLINE_WIDTH > 0.0:
			_apply_outline(_model_root)
		# 떠다님 몸짓·옷자락 물결 (#502) — 물결 몸은 틴트를 물결 재질에 넣는다(옛 표면 덮기 틴트 대신 — 틴트·물결·겉칠이 한 재질)
		_float = FLOAT_MOTION.new() if def.float_active() else null
		if _float == null or not _float.setup(self, def, _model_root, albedo_tint):
			_apply_albedo_tint(_model_root)
		_attach_weapon(def)
		_attach_sheath(def)
		_attach_cast_hand(def)
		_attach_springs(def)
		_attach_flare(def)
		loaded = true
	for p in _placeholders:
		if p is Node3D:
			(p as Node3D).visible = not loaded
	set_physics_process(_float != null)
	mark_char_light(self)   # 캐릭터 전용 조명 (#191) — 모델·무기·칼집·외곽선·플레이스홀더 전부
	_dead = false
	_busy_until = 0.0
	_committed = false
	_drop_marks()      # 새 몸 — 옛 애니에 걸린 칼(표)은 끊긴 휘두름이라 버린다(cancel만, #403)
	_swing_clip = ""
	_swing_hit = -1.0
	_current = ""
	_play("idle")
	if _tint_mat != null and not _overlay_busy:
		_restore_overlays()   # 새 몸에도 상태 틴트 (E2)
	if _anim and _anim_frozen:
		_anim.speed_scale = 0.0
	model_changed.emit(loaded)
	return loaded


func is_model_loaded() -> bool:
	return _model_root != null


## 손에 붙은 무기 노드 (없으면 null). 뷰어·테스트용.
func weapon_node() -> Node3D:
	return _weapon


## 칼집 노드(#430 e2e·시험용 — weapon_node()와 짝, 없으면 null).
func sheath_node() -> Node3D:
	return _sheathed


## 무기 칸 보이기/숨기기 (#430) — PlayerCombat._apply_to_player가 부르는 알림 자리. _weapon_active 선언·사유는 위 var 칸.
func set_weapon_active(active: bool) -> void:
	if active == _weapon_active:
		return
	_weapon_active = active
	_sync_swaps()
	if not _weapon_active and _trail != null:
		_trail.visible = false   # 숨기는 순간 그리던 검광도 끊는다 — 다음 휘두름부터는 start_trail이 거절한다


func weapon_active() -> bool:
	return _weapon_active


## 휘두르기 동안 검광 리본을 그린다. 무기(소켓)가 없거나 무기 칸이 숨어 있으면 false. 색은 큐 표(Vfx.CUES.sword_trail). tip_color = 칼끝 색(알파 0 = color와 같음, 스킬 = 도력 청 #59).
## 방금 튼 휘두름이 매듭 클립(#471 — D2R 타이밍으로 다시 짠 칼질)이면 빠른 구간만 굵게(TRAIL_FAST): 감기·장전·되돌림은 칼끝의 가는 선, 내려치기만 칼날 통째.
func start_trail(sec: float, color: Color, tip_color: Color = Color(0, 0, 0, 0)) -> bool:
	if not _weapon_active or _weapon == null or not is_instance_valid(_weapon):
		return false
	if _trail == null:
		_trail = SWORD_TRAIL.new()
		_trail.name = "SwordTrail"
		add_child(_trail)
		var aabb := AABB()
		var first := true
		for mi in _weapon.find_children("*", "MeshInstance3D", true, false):
			var m := mi as MeshInstance3D
			if m.mesh == null:
				continue
			# 무기 루트 기준 변환(중간 노드가 있어도)
			var xf := Transform3D.IDENTITY
			var n: Node = m
			while n != null and n != _weapon:
				if n is Node3D:
					xf = (n as Node3D).transform * xf
				n = n.get_parent()
			var box: AABB = xf * m.mesh.get_aabb()
			aabb = box if first else aabb.merge(box)
			first = false
		if not first:
			_trail_tip = Vector3(0, aabb.end.y, 0)
			_trail_base = Vector3(0, aabb.position.y + aabb.size.y * 0.3, 0)
	var fast := TRAIL_FAST if model != null and _swing_clip != "" and model.swing_knots.has(_swing_clip) else Vector2.ZERO
	_trail.call("begin", _weapon, _trail_tip, _trail_base, sec, color, tip_color, fast)
	return true


func trail_drawing() -> bool:
	return _trail != null and bool(_trail.call("is_drawing"))


## 칼이 지금 어떻게 움직이나 (보드 #184 — 두 동강 단면 = 칼 궤적 기울기): {axis = 밑동→칼끝(월드, 단위), vel = 칼끝 속도}.
## 검광 표본에서 잰다 — 휘두르는 중이 아니거나 무기가 없으면 {}. PlayerCombat._land가 막타 정보(blow.blade)에 싣는다.
func blade_motion() -> Dictionary:
	if _trail == null or not is_instance_valid(_trail):
		return {}
	return _trail.call("motion")


# ---------- 부착: 무기 소켓(§2.6)·칼집(#136)·시전 손(#223) ----------
# 만들어 붙이는 코드는 ActorAttachments(actors/actor_attachments.gd, #419) — 여기는 결과(붙은 노드)를 들고 클립에 맞춰 바꿔 끼운다.
# 부착 시점 = apply_node가 모델을 트리에 넣고 클립을 해석한 **뒤** weapon → sheath → cast_hand → springs → flare 순서(칼집이 손 칼을 복제하고, 펼침은 스프링 뒤에 얹힌다).

## 무기 = 별도 프롭, 손 본의 BoneAttachment3D 아래(§2.6). 못 붙이면 null → 검광·칼집 칼도 없다.
func _attach_weapon(def: ModelDef) -> void:
	_weapon = ATTACH.attach_weapon(_model_root, def)


## 칼집(#136) + 걷기 칼(#223, walk_blade = sheath): 칼집에 꽂힌 손 칼 사본이 오면 클립을 지켜본다(걷기 = 칼집 칼, 나머지 = 손 칼).
func _attach_sheath(def: ModelDef) -> void:
	_sheathed = ATTACH.attach_sheath(_model_root, def, _weapon)
	if _sheathed != null:
		_watch_clips()


## 시전 손(#223, ModelDef.cast_clip): 소품 손·부적·손 뼈·기본 배율을 받아 든다 — 시전 클립이 돌 때 _set_cast가 뼈를 줄이고 소품을 켠다.
func _attach_cast_hand(def: ModelDef) -> void:
	var c := ATTACH.attach_cast_hand(_model_root, def)
	if c == null:
		return
	_cast_prop = c.prop
	_cast_talisman = c.talisman
	_cast_sk = c.sk
	_cast_bone = c.bone
	_cast_base_scale = c.base_scale
	_watch_clips()


func _watch_clips() -> void:
	if _anim and not _anim.current_animation_changed.is_connected(_on_clip_changed):
		_anim.current_animation_changed.connect(_on_clip_changed)


## 바꿔 끼우기(#223): 클립이 바뀔 때마다 — 애니 플레이어 신호 + _play가 직접 부른다.
func _on_clip_changed(_name: String = "") -> void:
	_sync_swaps()


func _sync_swaps() -> void:
	if _anim == null:
		return
	var cur := String(_anim.current_animation)
	# 걷기 칼: 지금 클립이 걷기면 칼은 칼집에, 아니면 손에 — 무기 칸이 비거나 꺼지면(#430 _weapon_active) 둘 다 숨긴다
	if _sheathed != null and _weapon != null:
		var walk: String = _clips.get("walk", "")
		var inside := walk != "" and cur == walk
		_sheathed.visible = inside and _weapon_active
		_weapon.visible = not inside and _weapon_active
	elif _weapon != null:
		_weapon.visible = _weapon_active   # 칼집 없는 리그(산적 등)도 #430 토글은 받는다
	# 시전 손: 시전 클립이 도는 동안만 주먹 → 소품 손
	if _cast_prop != null:
		_set_cast(_def != null and cur == _def.cast_clip)


func _set_cast(on: bool) -> void:
	if on == _cast_on or _cast_sk == null:
		return
	_cast_on = on
	var s: float = maxf(0.001, _def.cast_hand_hide_scale) if on else 1.0
	_cast_sk.set_bone_pose_scale(_cast_bone, Vector3.ONE * s)   # 어떤 클립도 이 뼈의 크기 트랙이 없어 애니가 덮지 않는다
	_cast_prop.scale = Vector3.ONE * (_cast_base_scale / s)
	_cast_prop.visible = on
	if _cast_talisman:
		_cast_talisman.visible = on


## 시전 중 부적: 발동 시각(attack_impact[cast_clip]) 뒤에는 숨긴다 — _process가 매 프레임.
func _tick_cast() -> void:
	if not _cast_on or _cast_talisman == null or _anim == null:
		return
	var L := _len_of(_def.cast_clip)
	var rel := float(_def.attack_impact.get(_def.cast_clip, 1.0))
	_cast_talisman.visible = L <= 0.0 or _anim.current_animation_position < rel * L


## 칼이 지금 칼집에 꽂혀 있나 (걷기 중) — 뷰어·테스트용.
func blade_sheathed() -> bool:
	return _sheathed != null and _sheathed.visible


## 시전 손이 지금 끼워져 있나 / 부적이 보이나 — 테스트용.
func cast_hand_on() -> bool:
	return _cast_on


func cast_talisman_visible() -> bool:
	return _cast_on and _cast_talisman != null and _cast_talisman.visible


## 스프링본 (art_3d_pipeline §12·§12.3·§12.4, #143·#353) — 짜는 코드와 함정 주석은 ActorAttachments.attach_springs. 중심 = 배우 몸(이 노드의 부모).
## spring_chain_root = 사슬의 실제 뿌리 규칙(#353) — 시험·모델 검사가 `ActorVisual.spring_chain_root`로 부르던 자리 그대로(본체는 ActorAttachments).
static func spring_chain_root(sk: Skeleton3D, root: int, end: int) -> int:
	return ATTACH.spring_chain_root(sk, root, end)


func _attach_springs(def: ModelDef) -> void:
	ATTACH.attach_springs(_model_root, def, self)


## 자락 펼침 (art_3d_pipeline §12.3 ③, ActorAttachments.RobeFlare): 스프링 **뒤에** 붙는 수정자 — 순서는 apply_node가 지킨다.
func _attach_flare(def: ModelDef) -> void:
	if _model_root != null:
		ATTACH.attach_flare(self, def)


## 지금 자락이 벌어진 각(°) — 시험·도구용. 펼침이 없으면 -1.
func flare_angle() -> float:
	var sk := ActorVisual._first_skeleton(self)
	if sk == null:
		return -1.0
	var f := sk.get_node_or_null("RobeFlare") as RobeFlare
	return f.cur if f != null else -1.0


## 스프링본이 실제로 짜였나 (설정 수, 마디가 0인 설정 수) — 테스트·도구용.
func spring_state() -> Vector2i:
	var sk := ActorVisual._first_skeleton(self)
	if sk == null:
		return Vector2i(0, 0)
	var sim := sk.get_node_or_null("SpringBones") as SpringBoneSimulator3D
	if sim == null:
		return Vector2i(0, 0)
	var dead := 0
	for n in sim.get_setting_count():
		if sim.get_joint_count(n) < 1:
			dead += 1
	return Vector2i(sim.get_setting_count(), dead)


## 순간이동 직후 스프링 초기화 스위치 (#346) — 기본 켬. e2e `teleport_settle`이 같은 대본에서 「전」을 찍을 때만 끈다(게임 코드는 안 건드린다).
static var spring_reset_on_teleport: bool = true


## 스프링 꼬리를 **지금 자세·지금 자리**로 다시 놓는다 (#346) — 순간이동·층 이동·귀환문·서낭단 직후. 부르는 곳 = Player.teleport_to · Portal.restore_actor.
## = SpringBoneSimulator3D.reset() (4.7.2 `spring_bone_simulator_3d.cpp` 대조: 트리 안 + 스켈레톤이 있으면 **그 자리에서** 마디마다
##   current_tail = prev_tail = 지금 뼈 자세 × 중심 변환 — 다음 갱신으로 미루지 않는다) → 위치·배율을 **다 바꾼 뒤에** 부른다.
## 중심 = 배우 몸(#353)이라 몸이 옮겨 간 것은 이미 안 끌리지만, 귀환문의 Visual 배율 0.12 → 1(Portal.restore_actor)은 중심 **밖**의 변화라
## 꼬리가 오그라든 자리에 남아 자락이 몸 안으로 접힌다 — 그건 이 초기화로만 잡힌다. 반환 = 실제로 초기화했나(스프링 없음·트리 밖·스위치 끔 = false).
func reset_springs() -> bool:
	if not spring_reset_on_teleport:
		return false
	var sk := ActorVisual._first_skeleton(self)
	if sk == null:
		return false
	var sim := sk.get_node_or_null("SpringBones") as SpringBoneSimulator3D
	if sim == null or not sim.is_inside_tree():
		return false
	sim.reset()
	return true


func has_clip(kind: String) -> bool:
	return _clips.get(kind, "") != ""


## 동작 키 → 실제 클립 이름 ("" = 없음).
func clip_for(kind: String) -> String:
	return _clips.get(kind, "")


## 모델의 클립 이름 전부 (뷰어·검수용).
func clip_names() -> PackedStringArray:
	return _anim.get_animation_list() if _anim else PackedStringArray()


## 지금 재생 중인 클립 이름 ("" = 없음/모델 없음).
func current_clip() -> String:
	return _anim.current_animation if _anim else ""


## 뷰어용: 동작 키를 강제 재생(단발 잠금 무시).
func play_kind(kind: String) -> void:
	_busy_until = 0.0
	_committed = false
	_dead = false
	_play(kind, true)


## 뷰어용: 클립 이름 직접 재생.
## idle을 한 자세에 세운다 (보드 #91 — PD "마을 사람들 idle 모션은 정적으로").
## 왜 클립을 끄지 않고 멈추나: Meshy idle은 숨·무게중심까지 들어간 한 자세 뭉치라, 0프레임은 T-pose에 가까운 밋밋한 차렷이다.
## 클립 중간 한 지점에서 멈추면 "서 있는 사람" 자세가 그대로 남는다. at = 클립 안의 초(배우마다 달리 주면 셋이 같은 포즈로 굳지 않는다), 음수면 해제.
func freeze_idle(at: float) -> void:
	_idle_pose = at
	if _anim == null:
		return
	var n: String = _clips.get("idle", "")
	if n == "":
		return
	if at < 0.0:
		_anim.play(n, BLEND)
		return
	_current = n
	_anim.play(n)
	_hold_idle(n)


func _hold_idle(n: String) -> void:
	_anim.seek(clampf(_idle_pose, 0.0, maxf(0.0, _len_of(n) - 0.01)), true)
	_anim.pause()


func play_clip(name: String) -> void:
	if _anim and _anim.has_animation(name):
		_busy_until = _now() + 3600.0
		_committed = false
		_current = name
		_anim.play(name, BLEND)
		_anim.seek(0.0, true)


## 동작 키의 클립 길이(초). 없으면 0.
## 클립 **이름**의 길이 (동작 키가 아니라). 뷰어·스킬 코드가 특정 클립을 직접 지목할 때.
func clip_length_of(name: String) -> float:
	return _len_of(name)


## 모델의 발광을 끈다 (ModelDef.keep_emission 참고). 끈 재질 수를 돌려준다. 재질은 같은 GLB를 쓰는 배우끼리 나눠 가지므로 한 번 끄면 전부 꺼진다(의도).
static func strip_baked_emission(root: Node) -> int:
	var n := 0
	for mi in root.find_children("*", "MeshInstance3D", true, false):
		var mesh: Mesh = (mi as MeshInstance3D).mesh
		if mesh == null:
			continue
		for si in mesh.get_surface_count():
			var m := mesh.surface_get_material(si) as BaseMaterial3D
			if m and m.emission_enabled:
				m.emission_enabled = false
				n += 1
	return n


## 캐릭터 전용 조명 (보드 #191, dungeon.md §6.7, 디아2R §4.2): 렌더 레이어 2 = 배우. 레벨의 키·보조 방향광(Level._setup_char_lights)은
## light_cull_mask가 이 비트뿐이라 배경(비트 1만)을 건너뛰고 배우만 비춘다 — 방 밝기는 그대로, 어두운 방에서 인물만 또렷해진다.
const CHAR_LIGHT_LAYER := 1 << 1


## root(와 그 아래) 그리는 것 전부에 캐릭터 레이어를 **더한다** — 기본 비트 1은 그대로라 횃불·환경광·플레이어 빛은 계속 받는다.
## 표시한 개수를 돌려준다. static = 배우 밖에서 새로 만든 조각(처치 연출의 파편 등)도 같은 규칙으로 표시하게.
static func mark_char_light(root: Node) -> int:
	var n := 0
	if root is VisualInstance3D:
		(root as VisualInstance3D).layers |= CHAR_LIGHT_LAYER
		n += 1
	for vi in root.find_children("*", "VisualInstance3D", true, false):
		(vi as VisualInstance3D).layers |= CHAR_LIGHT_LAYER
		n += 1
	return n


## 판정 컷용(뷰어 `--fps`): 클립을 t초 자세로 멈춰 세운다. 벽시계 타이머 대신 정해진 시각을 찍어야 전후 비교가 프레임 단위로 맞는다. 게임 코드는 안 쓴다.
func pose_at(name: String, t: float) -> void:
	if _anim == null or not _anim.has_animation(name):
		return
	# 처음 세울 때는 섞기(BLEND) 없이 새로 튼다 — 배율 0에서는 섞기 시간도 안 흘러서 앞 동작(대기)에 묶인 채 굳는다(실측)
	if _anim.current_animation != name or _anim.speed_scale != 0.0:
		_anim.stop()
		_anim.play(name, 0.0)
	_anim.speed_scale = 0.0
	_anim.seek(t, true)
	_current = name
	_busy_until = _now() + 3600.0
	_committed = false


func clip_length(kind: String) -> float:
	var n: String = _clips.get(kind, "")
	return _anim.get_animation(n).length if (_anim and n != "") else 0.0


## 넘어진 **살아 있는** 몸 (combat_v2 §6.6, #145) — die 클립의 쓰러지는 대목(ModelDef.die_fall_from ~ 끝)만 자세로 빌린다.
## `play_die*`와 달리 `_dead`를 세우지 않는다 — 일어나서 다시 싸운다. k 0 = 쓰러지기 시작 · 1 = 다 누운 자세, 거꾸로 넣으면 일어난다.
## 클립이 없는 몸(박쥐 같은 정지 메시·캡슐)은 코드로 눕힌다(lie_down). 새 동작을 사지 않는 길(크레딧 0).
func pose_down(k: float) -> void:
	k = clampf(k, 0.0, 1.0)
	_posed = true
	var n: String = _clips.get("die", "")
	var dur := _len_of(n)
	if dur <= 0.0 or _def == null:
		lie_down(k)
		return
	var from := clampf(_def.die_fall_from, 0.0, maxf(0.0, dur - 0.05))
	pose_at(n, lerpf(from, maxf(dur - 0.02, from), k))


## 자세 고정만 푼다(배율·busy 되돌림) — 죽음처럼 다른 재생이 곧바로 이어질 때.
func pose_clear() -> void:
	_posed = false
	_busy_until = 0.0
	_committed = false
	if _anim:
		_anim.speed_scale = 0.0 if _anim_frozen else 1.0   # 얼어 있으면 멈춘 채 (E2 #202 — 넘어진 몸은 얼지 않지만 계약으로)


## 넘어짐이 끝났다 — 자세 고정을 풀고 대기로.
func pose_end() -> void:
	pose_clear()
	_current = ""
	lie_down(0.0)
	_play("idle", true)


## 매 물리 틱: 배우가 자기 속도(유닛/초)로 알려준다. idle/walk/run 전환과 **발 미끄럼 방지**(재생 배율 = 실제 속도 ÷ (클립 지면 속도 × 몸 크기), #501)는 여기서만.
## 왜 speed_scale인가: 이동 클립은 매 틱 속도가 바뀌므로 play()를 다시 부르지 않고 플레이어 배율만 바꾼다(단발 동작·히트스톱은 1.0으로 되돌린다).
## 비행 부유 (보드 #78): 리그가 없는 날짐승은 코드로 띄운다. 본이 있는 배우는 이 값이 0이라 그대로 지나간다.
func _process(delta: float) -> void:
	if _cast_on:
		_tick_cast()   # 시전 부적은 발동 뒤 사라진다 (#223)
	# 떠다님 몸짓 (#502) — 둥실·기울기·덮치기·움찔·흐려짐·옷자락을 한 층이 맡는다. 히트스톱·빙결·넘어짐 동안 멈추고, 죽으면 흩어짐 몫만(float_scatter)
	if _float != null:
		_float.tick(self, _model_root, delta, moving, _stopped or _anim_frozen or _posed, _dead)
		return
	# 죽으면 날갯짓·부유도 멈춘다 — 시체는 KillFx 시간표(lie_down)가 땅으로 내린다 (#183)
	# 넘어진 산 몸(_posed, §6.6 #145)도 멈춘다 — 안 멈추면 부유가 매 틱 누운 높이를 덮어써 박쥐가 누운 채 떠다닌다
	# 얼어 있는 동안도 멈춘다 (E2 #202)
	if _dead or _posed or _anim_frozen or _def == null or _model_root == null or _def.hover_amp <= 0.0:
		return
	_hover_t += delta
	var ph := _hover_t * _def.hover_hz * TAU
	_model_root.position.y = _def.y_offset + sin(ph) * _def.hover_amp
	_model_root.rotation.z = sin(ph * 0.5) * 0.10
	if _def.flap_amp > 0.0:
		var w: float = _def.scale * (1.0 - absf(sin(ph)) * _def.flap_amp)
		_model_root.scale = Vector3(w, _def.scale, _def.scale)


func set_moving(m: bool, speed: float = 0.0) -> void:
	moving = m
	if _dead or _now() < _busy_until:
		return
	if not moving:
		# 순환 평타가 막 끝났으면 유예 동안 그대로 둔다(남는 틈 + CHAIN_GRACE, #471) — 이어 치면 다음 평타가 곧 온다. 순환이 끝났으면 나가기 섞기로 대기에.
		var leaving := _chain.has(_current)
		if leaving and _now() < _busy_until + _swing_gap + CHAIN_GRACE:
			return
		_play("idle", false, model.chain_blend_out if leaving else BLEND)
		if _anim and not _stopped and not _anim_frozen:
			_anim.speed_scale = 1.0
		return
	var kind := "walk"
	var natural := model.walk_speed if model else 1.0
	if model and speed >= model.run_threshold_at(body_size()) and has_clip("run"):   # 0 = 저절로 × 몸 크기 (#506)
		kind = "run"
		natural = model.run_speed
	_play(kind)
	if _anim and not _stopped and not _anim_frozen and speed > 0.0 and natural > 0.0:
		var lo: float = model.loco_scale_min if model else 0.75
		var hi: float = model.loco_scale_max if model else 1.8
		_anim.speed_scale = clampf(speed / (natural * body_size()), lo, hi)


## 몸 크기 (#501, monster_motion_v2 §2.1 ⑤) = 이 노드의 배율 — Enemy가 변종·정예·우두머리·새끼 크기(Enemy.body_scale)를 여기 준다(도호·NPC = 1).
## 클립의 지면 속도(ModelDef.walk_speed·run_speed)는 몸 크기 1에서 잰 값이라, 큰 몸은 한 걸음에 땅을 더 가고 작은 몸은 덜 간다 —
## 재생 배율 = 빠르기 ÷ (지면 속도 × 몸 크기). 안 곱하면 새끼(×0.55)는 발이 몸보다 늦게, 우두머리(×1.2)는 빨리 쓸린다.
func body_size() -> float:
	var s := absf(scale.x)
	return s if s > 0.001 else 1.0


# ---------- 덮치기 (보드 #506, monster_motion_v2 §4.7) ----------
## 돌진 몸의 선딜 → 돌진 → 착지를 클립 셋으로 — pounce(웅크림 → 선딜 끝에 뛰어오름 → 뜬 자세) · pounce_air(뜬 자세 루프, 돌진 동안) · pounce_land(착지).
## tools/quad_gait.py가 굽는 네발 클립(들개 #501 · 흑랑 #506 — 장산범 자리표시도 흑랑 GLB). 돌진 이동·판정·연출(「!!」·링·소리·길이)은 배우(Enemy DASH ·
## Boss 돌격) 몫 — 여기는 그림만. 클립이 없는 몸(박쥐·캡슐·두 발 창)은 has_pounce() = false → 배우가 옛 길(공격 클립 · 걷기·달리기 클립)로.
const POUNCE := "pounce"
const POUNCE_AIR := "pounce_air"
const POUNCE_LAND := "pounce_land"
## pounce 클립에서 뛰어오른 뒤의 길이(초) = 뛰어오름 0.10 + 뻗음 0.05 (quad_gait POUNCE_AFTER). 뛰어오르는 때 = 클립 길이 − 이 값.
const POUNCE_AFTER := 0.15
## 웅크림 재생 배율 묶음 — 선딜이 구운 웅크림(흑랑 0.5 · 들개 0.45)과 크게 달라도(한기 ×1.1~1.25) 너무 느리거나 튀지 않게.
const POUNCE_RATE := Vector2(0.5, 2.0)


func has_pounce() -> bool:
	return _anim != null and _anim.has_animation(POUNCE) and _anim.has_animation(POUNCE_AIR)


## 선딜 windup초 동안 웅크렸다가 **선딜 끝에 뛰어오르게** pounce를 튼다(배율 = 뛰어오르는 때 ÷ 선딜). 뛰어오름이 끝날 때까지 걷기·대기로 안 바꾼다.
## 반환 = 틀었나 — 클립이 없거나 죽었으면 false(배우가 옛 길로).
func play_pounce(windup: float) -> bool:
	if _dead or not has_pounce():
		return false
	var length := _len_of(POUNCE)
	var rate := clampf((length - POUNCE_AFTER) / maxf(windup, 0.01), POUNCE_RATE.x, POUNCE_RATE.y)
	_busy_until = _now() + length / rate
	_committed = false
	_play_name(POUNCE, rate)
	return true


## 돌진 한 틱 (배우가 set_moving 대신 부른다) — 뛰어오름이 끝났으면 뜬 자세 루프(pounce_air). 몸은 땅을 가지만 걷기·달리기 클립으로 안 바꾼다.
func hold_air() -> void:
	if _dead or not has_pounce() or _now() < _busy_until:
		return
	if _current != POUNCE_AIR:
		_play_name(POUNCE_AIR, 1.0)


## 착지 (돌진 끝) — pounce_land를 틀고 그 길이만큼 걷기·대기를 막는다. 덮치던 몸(pounce · pounce_air)이 아니면 아무 일 없다.
func play_land() -> void:
	if _dead or not has_pounce() or not _anim.has_animation(POUNCE_LAND) or not (_current == POUNCE or _current == POUNCE_AIR):
		return
	_busy_until = _now() + _len_of(POUNCE_LAND)
	_committed = false
	_play_name(POUNCE_LAND, 1.0)


## 끊긴 덮치기 (빙결·목표 잃음 — Enemy._cancel_attack): 웅크림·뜬 자세의 잠금을 풀어 다음 걸음 틱이 대기·걷기로 섞어 돌아간다.
func cancel_pounce() -> void:
	if _current == POUNCE or _current == POUNCE_AIR:
		_busy_until = 0.0


## 발소리를 발 디딤(foot_down)으로 낼 수 있나 (#178). 모델이 있고 이동 클립(walk·run 중 있는 것) **전부**에 위상이 적혀 있을 때만 —
## 하나라도 비면 그 클립을 도는 동안 소리가 끊기므로, 차라리 배우가 거리로 세게 둔다.
func steps_synced() -> bool:
	return _steps_ready


func _has_step_phases(def: ModelDef) -> bool:
	if def == null or def.step_phases.is_empty():
		return false
	var any := false
	for kind in ["walk", "run"]:
		var n: String = _clips.get(kind, "")
		if n == "":
			continue
		if not (def.step_phases.get(n) is Vector2):
			return false
		any = true
	return any


## 애니 플레이어가 한 번 돈 직후 (#178). 이동 클립이면 위상이 디딤을 지났는지 보고 foot_down을 쏜다.
## 단발 동작(공격·피격)이 이동 중에 덮고 있으면 발이 안 딛으니 조용하다. 히트스톱(배율 0)은 위상이 안 움직여 조용하다.
func _on_mixer_applied() -> void:
	if not moving or _dead or _anim == null or _def == null:
		_step_clip = ""
		return
	var cur := String(_anim.current_animation)
	var marks: Variant = _def.step_phases.get(cur)
	if not (marks is Vector2):
		_step_clip = ""
		return
	var length := _len_of(cur)
	if length <= 0.0:
		return
	var ph := fposmod(_anim.current_animation_position / length, 1.0)
	if cur != _step_clip:
		# 처음부터 튼 게 아니라 도는 중에 만났다(_play가 표시 안 함) — 지나간 디딤을 소급하지 않고 지금부터 센다
		_step_clip = cur
		_step_prev = ph
		return
	for foot in phase_crossings(_step_prev, ph, marks):
		foot_down.emit(foot)
	_step_prev = ph


## prev → now 사이(prev 제외·now 포함)에 든 디딤의 발 번호를 지난 순서대로. now < prev = 클립이 끝에서 처음으로 넘어갔다.
## static인 이유: 단위 테스트가 트리·모델 없이 경계(0·끝·한 틱에 두 발)를 직접 검사한다.
static func phase_crossings(prev: float, now: float, marks: Vector2) -> Array[int]:
	var out: Array[int] = []
	var order: Array[int] = [0, 1]
	if marks.x > marks.y:
		order = [1, 0]
	if now >= prev:
		for f in order:
			if marks[f] > prev and marks[f] <= now:
				out.append(f)
	else:
		for f in order:
			if marks[f] > prev:
				out.append(f)
		for f in order:
			if marks[f] <= now:
				out.append(f)
	return out


## 단발 동작(attack/hit). 클립이 없으면 fallback_sec만 idle/walk 전환을 막는다(타이밍은 배우 로직이 잡음).
func play_once(kind: String, fallback_sec: float = 0.3) -> void:
	if _dead:
		return
	var n: String = _pick_attack() if kind == "attack" else String(_clips.get(kind, ""))
	var dur := _len_of(n)
	_busy_until = _now() + (dur if dur > 0.0 else fallback_sec)
	_committed = false
	if dur > 0.0:
		_play_name(n, 1.0)


## 이름으로 지목한 단발 클립을 sec초에 맞춰 한 번 튼다 (#513, monster_motion_v2 §5.6) — 동작 키(SYNONYMS) 밖의 행동 클립: 아귀 시체 먹기 `eat`.
## 재생 배율 = 클립 ÷ sec · 잠금 = sec(행동 시간과 동작이 같이 끝난다 — 먹기 1.5초 동안 숙여 집어 입으로 한 번). 클립이 없으면 거짓 → 부르는 쪽이 옛 길로.
## 대안 = SYNONYMS에 eat를 더해 play_once("eat") → 부분 일치가 다른 모델 클립 이름을 집을 수 있고(die 동의어 defeat ⊃ eat) play_once는 클립 길이로
## 잠가 먹는 시간과 어긋난다(7초 클립이 끝날 때까지 쫓기 걸음을 막는다) — 기각.
func play_fit(clip: String, sec: float) -> bool:
	if _dead or sec <= 0.0:
		return false
	var L := _len_of(clip)
	if L <= 0.0:
		return false
	_busy_until = _now() + sec
	_committed = false
	_play_name(clip, L / sec)
	return true


## 피격 (combat_v2 §6.2): 피격 클립을 ModelDef.hit_speed 배속으로 틀고 **lock_sec 동안만** idle/walk를 막는다(경직 = 배우가 이동을 멈추는 시간과 같은 길이).
## 클립이 더 길어도 경직이 끝나면 idle/walk가 블렌드로 덮는다 — 피격 자세로 미끄러지며 걷는 것(PD 지적)을 막는 핵심.
## 공격 클립을 휘두르는 중이면 클립은 바꾸지 않는다(칼이 닿는 시각·임팩트 동기 유지, 플래시·히트스톱만).
## away = 맞은 쪽 반대(월드 수평 — Enemy.receive_attack의 넉백 방향, 0이면 몸 뒤): 떠다님 몸(#502)의 움찔·흐려짐 방향. 클립 몸은 안 쓴다.
func play_hit(lock_sec: float, away: Vector3 = Vector3.ZERO) -> void:
	if _dead:
		return
	if _now() < _busy_until and _attack_clips.has(_current):
		return
	var n: String = _clips.get("hit", "")
	_busy_until = _now() + lock_sec
	_committed = false
	if n != "":
		_play_name(n, model.hit_speed if model else 2.5)
	if _float != null:
		_float.flinch(self, away)


## 공격 휘두르기 (combat_v2 §6): 클립을 interval(=1/공속) × 채움(ModelDef.swing_fill, 없으면 1) 초 안에 끝나게 재생해 공속이 곧 휘두르는 속도가 된다(디아2 IAS 감각).
## 반환 = 칼이 닿는 시각(초, 지금부터). 클립이 없으면 0 → 호출자가 즉시 타격. 배율 = ModelDef.attack_speed(휘두름 바닥 SWING_MIN_SEC · 느린 쪽 0.5배 — 시뮬·도구와 한 셈, #471·#493).
## 채움 < 1(#471 1타 0.66)이면 휘두름(동작 커밋)이 간격보다 일찍 끝나고, 다음 평타(간격 뒤)까지 끝 자세로 선다(_swing_gap — 초당 휘두름·DPS 그대로).
## 평타 순환 (#141, §6.5): ModelDef.attack_chain이 있으면 순서대로(chain_next_step) — 없으면 무작위. count = false(클립 없는 스킬이 평타로
## 되돌아온 휘두름)는 순환을 세지 않는다. 섞기 = 순서대로 이어 칠 때 chain_blend, 그 밖(처음부터 다시·대기·달리기·피격·스킬에서) chain_blend_in.
func play_attack(interval: float, count: bool = true) -> float:
	if _dead:
		return 0.0
	var n := ""
	var blend := BLEND
	last_chain_step = -1
	if count and not _chain.is_empty():
		var step := chain_next_step()
		# 순환 안 섞기 = 방금 친 칸의 클립이 아직 돌고 있고 이번이 그 다음 칸일 때만(이음새를 클립 복귀에서 맞춘 쌍).
		# 처음부터 다시(타깃 바뀜 — 1타·2타 끝 → 1타는 46~50° 차)·대기·달리기·피격·스킬에서 = 들어가기 섞기
		var cycled := _chain_i >= 0 and _current == _chain[_chain_i] and step == (_chain_i + 1) % _chain.size()
		blend = model.chain_blend if cycled else model.chain_blend_in
		n = _chain[step]
		_chain_i = step
		last_chain_step = step
	else:
		n = _pick_attack()
	var clip_len := _len_of(n)
	if clip_len <= 0.0 or interval <= 0.0:
		_begin_swing("", 0.0, 1.0)   # 클립 없는 휘두름(플레이스홀더) — 칼이 닿는 순간은 곧바로(on_impact 안전판)
		_busy_until = _now() + maxf(interval * 0.5, 0.2)
		_swing_end = _busy_until
		_swing_gap = 0.0
		return 0.0
	var speed := model.attack_speed(n, clip_len, interval)
	var duration := clip_len / speed
	_busy_until = _now() + duration
	_swing_gap = maxf(0.0, interval - duration)
	_swing_end = _busy_until + _swing_gap   # 순환의 쉼은 이 칸(간격)이 끝난 때부터 — 틈은 끝 자세로 선 것이지 쉰 게 아니다(#471)
	attack_swings += 1
	_begin_swing(n, impact_frac(n), speed)
	_play_name(n, speed, blend)
	return impact_frac(n) * duration


## 평타 한 번의 동작 길이(초) — play_attack이 이 클립을 간격 interval로 틀 때(클립 ÷ ModelDef.attack_speed). 클립이 없으면 0. 시험·e2e가 동작 끝을 잰다.
func attack_duration(clip: String, interval: float) -> float:
	var L := _len_of(clip)
	if L <= 0.0 or interval <= 0.0 or model == null:
		return 0.0
	return L / model.attack_speed(clip, L, interval)


## 적 공격 (보드 #503, monster_motion_v2 §5.5 ④) — 선딜을 걸 때 부른다(Enemy._begin_windup). ModelDef.attack_fit이면 공격 클립(무작위 attack*)의
## 재생 배율을 클립 타격(impact_frac × 길이)이 **선딜 끝**(피해·투사체가 나가는 때)에 오게 한다(ModelDef.windup_speed — 한 셈) · 잠금 = 클립 ÷ 배율.
## 켜지 않은 모델·클립 없는 몸은 옛 길 그대로(play_once("attack", 선딜 + 0.25) — 1배속). 반환 = 재생 배율(옛 길 1, 죽었으면 0).
func play_windup(windup: float) -> float:
	if _dead:
		return 0.0
	if model == null or not model.attack_fit or _attack_clips.is_empty():
		play_once("attack", windup + 0.25)
		return 1.0
	var n := _pick_attack()
	var L := _len_of(n)
	var sp := ModelDef.windup_speed(impact_frac(n) * L, windup, model.attack_fit_range)
	_busy_until = _now() + L / sp
	_committed = false
	_play_name(n, sp)
	return sp


## 다음 평타가 순환 몇 번째 칸인가(고르지 않고 보기만) — 순환이 없으면 -1. 처음·reset_chain() 뒤·마지막 휘두름이 끝나고
## ModelDef.chain_reset_sec 넘게 쉬었으면 0(1타), 아니면 다음 칸(마지막 칸 다음은 0).
func chain_next_step() -> int:
	if _chain.is_empty():
		return -1
	if _chain_i < 0 or _now() - _swing_end > model.chain_reset_sec:
		return 0
	return (_chain_i + 1) % _chain.size()


## 순환을 처음(1타)으로 — 타깃이 바뀔 때(PlayerCombat.set_target)·새 판·부활.
func reset_chain() -> void:
	_chain_i = -1


## 마지막 play_attack이 순환의 마지막 칸(3타)이었나 — 넉백 보너스(PlayerCombat.FINISHER_KNOCK).
func is_chain_finisher() -> bool:
	return last_chain_step >= 0 and last_chain_step == _chain.size() - 1


## 쓰는 평타 순서 (빈 배열 = 무작위) — 시험·뷰어용.
func chain_clips() -> PackedStringArray:
	return _chain


## 스킬 전용 공격 클립 (보드 #67). 기본 공격과 달리 **이름으로 지목**하고 재생 배율도 스킬이 정한다 —
## 스킬은 공속이 아니라 제 동작 길이로 읽혀야 한다(강타는 묵직하게, 찌르기는 빠르게).
## 반환 = 칼이 닿는 시각(초). 클립이 없으면 -1 → 호출자가 기본 공격으로 되돌아간다.
func play_skill(clip: String, speed: float = 1.0) -> float:
	if _dead:
		return -1.0
	var clip_len := _len_of(clip)
	if clip_len <= 0.0:
		return -1.0
	var sp: float = clampf(speed, 0.25, 4.0)
	var duration := clip_len / sp
	_busy_until = _now() + duration
	_swing_end = _busy_until   # 스킬도 쉰 게 아니다 — 평타 순환의 쉼은 스킬이 끝난 때부터 다시 잰다(순환을 끊지도 세지도 않는다, §6.5)
	_swing_gap = 0.0
	_begin_swing(clip, impact_frac(clip), sp)
	_play_name(clip, sp)
	return impact_frac(clip) * duration


## 클립의 타격 시각 비율(0~1). 시간 왜곡된 클립이면 칼끝 최고속(swing_warp[clip].y, 원래 비율)이 옮겨 간 자리 — 칸 다섯이면 W+S,
## 매듭(#471)이면 그 꺾은선이 보낸 자리. 아니면 ModelDef.attack_impact[clip] → 기본값.
func impact_frac(clip: String) -> float:
	if model == null:
		return 0.45
	if _anim and _anim.has_animation(clip) and _anim.get_animation(clip).has_meta(SWING_META) and model.swing_warp.has(clip):
		return knot_unmap((model.swing_warp[clip] as Vector3).y, model.knots_for(clip))
	return float(model.attack_impact.get(clip, model.attack_impact_default))


# ---------- 동작 커밋 · 칼이 닿는 순간 (보드 #424, combat_v2.md §9.2) ----------
# 왜 이 구조인가: 피해를 「시전 + delay초」 타이머로 걸면 명중 멈춤(hit_stop)·피격 멈춤으로 클립이 서 있는 동안에도 시계는 흘러 칼보다 먼저 들어가고
# (#424 1단계 실측 — 평타 중 참격 −8틱), 휘두름이 다른 클립에 덮여도 예약 피해가 남아 「보이지 않는 칼」이 된다. 그래서 칼이 닿는 순간을 **애니 재생 위치**에
# 묶는다 — 휘두름 클립이 impact 비율을 지나는 애니 틱(mixer_applied = 그 틱 칼 자세가 선 직후)에 부른다. 대안 = 타이머를 멈춤만큼 미루기 → 멈춤의 출처
# (자기 명중·피격·빙결)마다 셈을 따로 맞춰야 하고 덮인 휘두름은 여전히 남는다, 기각.
# 끊긴 휘두름 (#403): 휘두름에 묶인 예약은 **그 휘두름 클립이 화면에서 칼이 닿을 때만** 부른다 — 끊기면(새 휘두름 · 휘두름 아닌 클립(사망·컷씬 동작) ·
# 모델 교체 · 순간이동·층 이동 cancel_swing) 피해·곁들이(반달·고리·도약 궤적·흙먼지·도장·타격 소리·부적 발동)를 버리고 cancel만 부른다. 애니 틱과 안전판 타이머
# 두 길이 이 규칙 하나를 지난다(_on_mixer_marks · _mark_due). 전(#424): 휘두름 아닌 클립으로 끊기면 옛 예약 시각에 타이머로 불렀다 — 사망한 도호의 돌진 궤적·
# 흙먼지가 뒤늦게 뜨고, 층을 옮기면 옛 층의 칼이 새 층 옛 자리를 쳤다(e2e invisible_sword). 대안 = 예약마다 「죽었나·층이 같나」를 따로 묻기 → 곁들이 하나를
# 빠뜨리면 새고(돌진 궤적·흙먼지가 그랬다) 컷씬 동작 같은 새 끊김마다 다시 막아야 한다, 기각.

## 새 휘두름 — 앞 휘두름이 못 닿은 칼은 버린다(새 휘두름이 덮었다 = 보이지 않는 칼 없음, #424). 클립 없는 휘두름은 clip = "".
func _begin_swing(clip: String, hit_ratio: float, speed: float) -> void:
	_drop_marks()
	_swing_no += 1
	_swing_clip = clip
	_swing_speed = maxf(speed, 0.001)
	_swing_hit = hit_ratio * _len_of(clip) if clip != "" else -1.0
	_committed = true
	if TRACE.enabled():
		TRACE.event("swing_begin", "ActorVisual._begin_swing", self, {"clip": clip, "hit_ratio": TRACE.exact(hit_ratio), "speed": TRACE.exact(speed)})


## 휘두르는 중인가 (#424 ① 동작 커밋) — play_attack·play_skill이 튼 동작이 끝나기(_busy_until, 칼이 닿은 뒤 복귀까지) 전.
## Player가 이동·새 명령을 이 동안 버퍼에 담고, PlayerCombat이 피격 클립을 안 튼다. 피격·단발 클립이 busy를 잡은 동안은 거짓.
func swing_busy() -> bool:
	return _committed and not _dead and _now() + BUSY_EPS < _busy_until


## 칼이 닿는 순간에 cb (#424 ②) — 방금 튼 휘두름(play_attack·play_skill 바로 뒤에 부른다)의 클립이 impact(− lead초만큼 앞 — 반달·고리 곁들이)를 지나는
## 애니 틱에. 명중·피격 멈춤으로 클립이 서 있으면 그만큼 늦게 — 늘 칼과 같은 프레임. delay = 옛 예약 시각(초, 재생 배율로 셈한 값).
## 안전판: delay ≤ 0(클립 없는 휘두름)이면 곧바로 · 지금 도는 휘두름 클립이 없으면(휘두름 없이 부른 예약 — 시험·도구) delay초 뒤 옛 타이머 경로.
## 휘두름이 끊기면(새 휘두름 · 휘두름 아닌 클립 — 사망·컷씬 · 모델 교체 · cancel_swing) 버리고 cancel만 부른다(보이지 않는 칼 없음, #403).
## 타이머 경로도 트리 멈춤을 따른다(#156). 반환 = 걸었나(false = 곧바로 불렀다).
func on_impact(cb: Callable, delay: float, lead: float = 0.0, cancel: Callable = Callable()) -> bool:
	if delay <= 0.0:
		if TRACE.enabled():
			TRACE.event("mark_immediate", "ActorVisual.on_impact", self, {"delay": TRACE.exact(delay)})
		cb.call()
		return false
	return _add_mark(maxf(0.0, _swing_hit - lead * _swing_speed), cb, maxf(0.0, delay - lead), cancel)


## 휘두름 클립이 ratio(0~1, 지금 쓰는 — 시간 왜곡된 — 클립 비율)를 지나는 애니 틱에 cb (#424 — 돌진베기가 땅을 떠나는 때). delay = 옛 셈의 그 시각(초, 안전판).
func on_swing_ratio(ratio: float, cb: Callable, delay: float) -> bool:
	if delay <= 0.0:
		if TRACE.enabled():
			TRACE.event("mark_immediate", "ActorVisual.on_swing_ratio", self, {"delay": TRACE.exact(delay)})
		cb.call()
		return false
	return _add_mark(clampf(ratio, 0.0, 1.0) * _len_of(_swing_clip), cb, delay, Callable())


## 지금 휘두름 클립이 돌고 있나 — 칼이 닿는 순간을 애니에 묶을 수 있는가.
func _swing_playing() -> bool:
	return _swing_hit >= 0.0 and _anim != null and not _dead and String(_anim.current_animation) == _swing_clip


## 휘두름 클립이 비율 a → b 사이 어디인가(0~1, 지금 쓰는 클립 비율) — 도약(#424, Player.leap_to)이 몸을 이 진행에 묶는다. 휘두름 클립이 안 돌면 −1.
func swing_progress(a: float, b: float) -> float:
	if _anim == null or _swing_clip == "" or _dead or String(_anim.current_animation) != _swing_clip or b <= a:
		return -1.0
	var r := _anim.current_animation_position / maxf(_anim.current_animation_length, 0.0001)
	return clampf((r - a) / (b - a), 0.0, 1.0)


## 원본 클립 비율 → 지금 쓰는 클립 비율 (#424) — 원본 동작에 박힌 순간(도약이 땅을 떠나는 때, ModelDef.leap_takeoff)을 시간 왜곡(§6.4) 뒤 시각으로.
## 왜곡 안 된 클립이면 그대로.
func warped_ratio(clip: String, orig: float) -> float:
	if model == null or _anim == null or not _anim.has_animation(clip) or not _anim.get_animation(clip).has_meta(SWING_META):
		return orig
	var k := model.knots_for(clip)
	return knot_unmap(orig, k) if not k.is_empty() else orig


func _add_mark(at: float, cb: Callable, due: float, cancel: Callable) -> bool:
	if _anim == null or not is_inside_tree():
		cb.call()
		return false
	if _marks_anim != _anim:
		_marks_anim = _anim
		if not _anim.mixer_applied.is_connected(_on_mixer_marks):
			_anim.mixer_applied.connect(_on_mixer_marks)
	# no = 묶인 휘두름 번호 · −1 = 휘두름 없이 건 예약(타이머로만 온다 — 새 휘두름이 버리지 않는다)
	var mk := {"no": _swing_no if _swing_playing() else -1, "at": at, "cb": cb, "cancel": cancel, "late": false, "done": false}
	_marks.append(mk)
	if TRACE.enabled():
		TRACE.event("mark_register", "ActorVisual._add_mark", self, {"mark_swing": TRACE.relative_swing(self, int(mk.no)), "raw_mark_swing": TRACE.decimal(int(mk.no)), "at": TRACE.exact(at), "due": TRACE.exact(due), "pending": _marks.size(), "timer_process_in_physics": false})
	get_tree().create_timer(due, false).timeout.connect(_mark_due.bind(mk))   # 안전판도 트리 멈춤을 따른다(#156 — process_always 끔)
	return true


## 애니가 한 틱 돈 직후 — 휘두름 클립이 표의 시각을 지났으면 그 칼을 부른다(칼 자세가 선 바로 그 틱). 명중 멈춤(배율 0)이면 위치가 안 움직여 기다린다.
## 묶인 휘두름이 끊겼으면(휘두름 아닌 클립 · 사망 · 모델 교체) 버린다(#403). 휘두름 없이 건 예약(no −1)은 옛 예약 시각이 지나면 부른다(안전판).
func _on_mixer_marks() -> void:
	if TRACE.enabled():
		TRACE.event("mixer_applied", "ActorVisual._on_mixer_marks", self, {"pending": _marks.size()})
	if _marks.is_empty():
		return
	var playing := _swing_on_screen()
	var pos := _anim.current_animation_position if playing else 0.0
	for mk in _marks.duplicate():
		if bool(mk.done):
			continue
		if int(mk.no) < 0:
			if bool(mk.late):
				_fire_mark(mk)
		elif not playing or int(mk.no) != _swing_no:
			_cancel_mark(mk)
		elif pos + 0.0001 >= float(mk.at):
			_fire_mark(mk)
	_marks = _marks.filter(func(m: Dictionary) -> bool: return not bool(m.done))


## 옛 예약 시각이 왔다 — 묶인 휘두름 클립이 아직 돌면(멈춤으로 늦다) 애니가 부르게 두고, 끊겼으면 버린다(#403 — 전엔 여기서 옛 타이머로 불렀다).
## 휘두름 없이 건 예약(no −1 — 시험·도구)만 지금 부른다.
func _mark_due(mk: Dictionary) -> void:
	if TRACE.enabled():
		TRACE.event("mark_timer_due", "ActorVisual._mark_due", self, {"mark_swing": TRACE.relative_swing(self, int(mk.no)), "raw_mark_swing": TRACE.decimal(int(mk.no)), "at": TRACE.exact(float(mk.at)), "late": bool(mk.late), "already_done": bool(mk.done)})
	if bool(mk.done):
		return
	mk.late = true
	if int(mk.no) < 0:
		_fire_mark(mk)
	elif int(mk.no) == _swing_no and _swing_on_screen():
		return
	else:
		_cancel_mark(mk)
	_marks = _marks.filter(func(m: Dictionary) -> bool: return not bool(m.done))


## 지금 휘두름 클립이 화면에서 돌고 있나 — 살아 있고 · 애니가 그 클립을 튼다(멈춤으로 서 있어도 참).
func _swing_on_screen() -> bool:
	return _anim != null and not _dead and _swing_clip != "" and String(_anim.current_animation) == _swing_clip


func _fire_mark(mk: Dictionary) -> void:
	if TRACE.enabled():
		TRACE.event("mark_fire", "ActorVisual._fire_mark", self, {"mark_swing": TRACE.relative_swing(self, int(mk.no)), "raw_mark_swing": TRACE.decimal(int(mk.no)), "at": TRACE.exact(float(mk.at)), "late": bool(mk.late), "already_done": bool(mk.done)})
	mk.done = true
	var cb: Callable = mk.cb
	if cb.is_valid():
		cb.call()


## 끊긴 휘두름의 예약 하나 — 부르지 않고 cancel(바닥 예고 걷기 등)만.
func _cancel_mark(mk: Dictionary) -> void:
	if TRACE.enabled():
		TRACE.event("mark_cancel", "ActorVisual._cancel_mark", self, {"mark_swing": TRACE.relative_swing(self, int(mk.no)), "raw_mark_swing": TRACE.decimal(int(mk.no)), "at": TRACE.exact(float(mk.at)), "late": bool(mk.late), "already_done": bool(mk.done)})
	mk.done = true
	var c: Callable = mk.cancel
	if c.is_valid():
		c.call()


## 새 휘두름이 덮었다 · 휘두름을 끊었다 — 휘두름에 묶인 못 닿은 칼은 버리고 cancel만. 휘두름 없이 건 예약(no −1)은 제 타이머로 온다.
func _drop_marks() -> void:
	var keep: Array = []
	for mk in _marks:
		if bool(mk.done):
			continue
		if int(mk.no) < 0:
			keep.append(mk)
			continue
		_cancel_mark(mk)
	_marks = keep


## 휘두름을 끊는다 (#403) — 칼이 닿을 자리가 사라졌다(순간이동·층 이동 — Player.teleport_to). 못 닿은 칼·곁들이는 버리고(cancel만) 동작 커밋을 푼다 —
## 새 자리에서 옛 영역을 치지 않고, 도호는 곧바로 선다(클립은 다음 set_moving이 대기로 섞는다). 휘두르는 중이 아니면 아무 일 없다.
func cancel_swing() -> void:
	_drop_marks()
	if _committed:
		_committed = false
		_busy_until = minf(_busy_until, _now())
	_swing_gap = 0.0   # 끊긴 휘두름은 끝 자세로 서지 않는다 — 옛 유예(CHAIN_GRACE)만 (#471)
	_swing_clip = ""
	_swing_hit = -1.0


## 되풀이 휘두름 한 바퀴 (#478 칼바람 — power_feel_v2 §2.2): clip을 loop_sec초에 끝나게 처음부터 튼다. play_skill과 같은 길(동작 커밋 · 칼이 닿는 표 ·
## 검광이 이 휘두름에 묶인다) — 다른 점은 배율 상한(4배)이 없다는 것 하나: 한 바퀴 길이를 부르는 쪽(SkillDef.tick_sec)이 정한다(회오리 2.53초 → 0.3초 = 8.4배).
## 클립 자체(길이·시간 왜곡·매듭)는 읽기만 한다 — 회오리 시간을 다시 짜도(#493) 한 바퀴 = loop_sec, 칼이 닿는 비율은 impact_frac을 따라간다.
## 바퀴마다 부르면 같은 클립이 처음부터 다시 돈다(클립이 360° 한 바퀴라 끝 자세 = 처음 자세 — 섞기 0). 첫 바퀴(대기·걷기에서)만 blend를 준다.
## 반환 = 칼이 닿는 시각(초) · 클립이 없으면 −1.
func play_swing_loop(clip: String, loop_sec: float, blend: float = 0.0) -> float:
	if _dead:
		return -1.0
	var clip_len := _len_of(clip)
	if clip_len <= 0.0 or loop_sec <= 0.0:
		return -1.0
	var sp := clip_len / loop_sec
	_busy_until = _now() + loop_sec
	_swing_end = _busy_until
	_swing_gap = 0.0
	_begin_swing(clip, impact_frac(clip), sp)
	_play_name(clip, sp, blend)
	return impact_frac(clip) * loop_sec


# ---------- 휘두르기 시간 왜곡 (보드 #123, combat_v2.md §6.4) ----------
## 왜 필요한가(swing_probe 실측): 도호 공격 클립은 칼끝이 가장 빠른 순간은 짧고 뾰족한데(뾰족함 3.9~6.6),
## **벤 뒤 꼬리가 클립의 38~73%**다. 게다가 공속에 맞춰 클립 전체를 같은 배율로 돌리니 예비 동작까지 뭉개진다 —
## 눈에는 "휙 하고 흐느적 돌아온다"로 보인다. 조선 검술 레퍼런스(보드 #123)는 반대다: 크게 들고 → 순식간에 치고 → 낮게 박힌 채 버틴다.
## 그래서 클립 길이는 그대로 두고(공속 계산 불변) **시간 배분만** 다시 짠다. 모양(자세)은 원래 클립 그대로다.

const SWING_META := &"swing_warped"


## 새 시간 u(0~1) → 원래 클립 시간 비율. win = (타격 시작, 최고속, 가라앉음), ph = (예비 W, 타격 S, 제동 F, 멈춤 H).
static func swing_map(u: float, win: Vector3, ph: Vector4) -> float:
	var r := 1.0 - ph.x - ph.y - ph.z - ph.w
	if u <= ph.x:
		return win.x * (u / ph.x)
	u -= ph.x
	if u <= ph.y:
		return win.x + (win.y - win.x) * (u / ph.y)
	u -= ph.y
	if u <= ph.z:
		return win.y + (win.z - win.y) * (u / ph.z)
	u -= ph.z
	if u <= ph.w:
		return win.z   # 멈춤 — 끝 자세를 그대로 든다
	u -= ph.w
	return win.z + (1.0 - win.z) * clampf(u / maxf(r, 0.001), 0.0, 1.0)


## swing_map의 역(원래 비율 → 새 비율). 메서드·오디오처럼 표본을 못 뜨는 트랙의 키 시각을 옮길 때만 쓴다.
static func swing_unmap(o: float, win: Vector3, ph: Vector4) -> float:
	var r := 1.0 - ph.x - ph.y - ph.z - ph.w
	if o <= win.x:
		return ph.x * (o / maxf(win.x, 0.001))
	if o <= win.y:
		return ph.x + ph.y * ((o - win.x) / maxf(win.y - win.x, 0.001))
	if o <= win.z:
		return ph.x + ph.y + ph.z * ((o - win.y) / maxf(win.z - win.y, 0.001))
	return ph.x + ph.y + ph.z + ph.w + r * ((o - win.z) / maxf(1.0 - win.z, 0.001))


## 창이 말이 되는가 — 0 < 시작 < 최고속 < 가라앉음 < 1, 배분 합 < 1.
static func swing_valid(win: Vector3, ph: Vector4) -> bool:
	return 0.0 < win.x and win.x < win.y and win.y < win.z and win.z < 1.0 		and ph.x > 0.0 and ph.y > 0.0 and ph.z > 0.0 and ph.w >= 0.0 and ph.x + ph.y + ph.z + ph.w < 0.95


## 원래 클립을 다시 표본 떠서 시간 배분만 바꾼 새 클립을 만든다 — 칸 다섯(창 + 배분)을 꺾은선으로 바꿔 warp_knots(모양 그대로).
static func warp_swing(src: Animation, win: Vector3, ph: Vector4, fps: float = 60.0) -> Animation:
	return warp_knots(src, ModelDef.phase_knots(win, ph), fps)


# ---------- 매듭 꺾은선 (보드 #471, power_feel_v2 §5) ----------
# 왜 꺾은선 하나로 모으나: 칸 다섯(#123)은 꺾은선의 한 모양일 뿐이다 — 매듭을 더 두면 장전 멈춤(같은 원래 비율 두 매듭)·되돌림에서 끝의 선 자세 빼기가
# 같은 함수로 된다. 불러올 때 왜곡(여기)·칼이 닿는 비율(impact_frac)·도약 비율(warped_ratio)·도구(motion_audit·swing_probe)가 같은 꺾은선을 읽는다.
# 대안 = GLB에 새 클립을 구워 넣기(anim_v2 §6 tripo_anim) → 텍스처를 다시 싸며 외형이 흔들리고(#141 채도 0.290 → 0.289) 전/후를 데이터 한 줄로
# 오가지 못한다. 파일 굽기는 새 동작(키 포즈)을 만들 때로 미룬다.

## 새 시간 비율 u(0~1) → 원래 클립 비율. k = [(u, o)] 꺾은선(첫 (0,0) · 끝 (1,1) · u는 늘기만). 셈 본체 = ClipRemake(#503에서 옮김 — 부르는 이름은 그대로).
static func knot_map(u: float, k: PackedVector2Array) -> float:
	return CLIP.knot_map(u, k)


## knot_map의 역(원래 비율 → 새 비율) — o에 **처음** 닿는 u(멈춤 매듭이면 멈춤의 시작). 메서드·오디오 트랙 키·칼이 닿는 비율·도약 비율.
static func knot_unmap(o: float, k: PackedVector2Array) -> float:
	return CLIP.knot_unmap(o, k)


## 꺾은선이 말이 되는가 — 둘 이상 · 첫 (0,0) · 끝 (1,1) · u는 늘기만(0.000001 넘게) · o는 줄지 않는다 · o는 0~1.
static func knots_valid(k: PackedVector2Array) -> bool:
	if k.size() < 2 or not k[0].is_equal_approx(Vector2.ZERO) or not k[k.size() - 1].is_equal_approx(Vector2.ONE):
		return false
	for i in range(1, k.size()):
		if k[i].x <= k[i - 1].x + 0.000001 or k[i].y < k[i - 1].y - 0.000001 or k[i].y < 0.0 or k[i].y > 1.0:
			return false
	return true


## 이 모델의 이 클립을 다시 짤 꺾은선 — 매듭(swing_knots) 또는 창 + 배분(swing_warp, swing_valid). 적힌 게 없거나 잘못 적혔으면 빈 배열(원래 속도).
## ActorVisual(불러올 때)·motion_audit·swing_probe가 같은 길로 고른다.
static func swing_knots_of(def: ModelDef, clip: String) -> PackedVector2Array:
	if def == null:
		return PackedVector2Array()
	if not def.swing_knots.has(clip) and (not def.swing_warp.has(clip) or not swing_valid(def.swing_warp[clip], def.phases_for(clip))):
		return PackedVector2Array()
	var k := def.knots_for(clip)
	return k if knots_valid(k) else PackedVector2Array()


## 원래 클립을 다시 표본 떠서 시간만 바꾼 새 클립 — 60fps + 매듭마다 키(최고속·멈춤이 표본 사이에 뭉개지지 않게). 길이는 그대로(공속 셈 불변).
static func warp_knots(src: Animation, k: PackedVector2Array, fps: float = 60.0) -> Animation:
	var L := src.length
	var dst := Animation.new()
	dst.length = L
	dst.loop_mode = src.loop_mode
	var times: Array[float] = []
	var n := int(ceil(L * fps))
	for i in n + 1:
		times.append(minf(L, float(i) / fps))
	for kn in k:
		times.append(clampf(kn.x, 0.0, 1.0) * L)
	times.sort()
	var uniq: Array[float] = []
	for t in times:
		if uniq.is_empty() or t - uniq[-1] > 0.0005:
			uniq.append(t)
	for tr in src.get_track_count():
		var ty := src.track_get_type(tr)
		var ni := dst.add_track(ty)
		dst.track_set_path(ni, src.track_get_path(tr))
		dst.track_set_interpolation_type(ni, src.track_get_interpolation_type(tr))
		dst.track_set_enabled(ni, src.track_is_enabled(tr))
		match ty:
			Animation.TYPE_ROTATION_3D:
				for t in uniq:
					dst.rotation_track_insert_key(ni, t, src.rotation_track_interpolate(tr, knot_map(t / L, k) * L))
			Animation.TYPE_POSITION_3D:
				for t in uniq:
					dst.position_track_insert_key(ni, t, src.position_track_interpolate(tr, knot_map(t / L, k) * L))
			Animation.TYPE_SCALE_3D:
				for t in uniq:
					dst.scale_track_insert_key(ni, t, src.scale_track_interpolate(tr, knot_map(t / L, k) * L))
			Animation.TYPE_BLEND_SHAPE:
				for t in uniq:
					dst.blend_shape_track_insert_key(ni, t, src.blend_shape_track_interpolate(tr, knot_map(t / L, k) * L))
			Animation.TYPE_VALUE:
				dst.value_track_set_update_mode(ni, src.value_track_get_update_mode(tr))
				for t in uniq:
					dst.track_insert_key(ni, t, src.value_track_interpolate(tr, knot_map(t / L, k) * L))
			_:
				for ki in src.track_get_key_count(tr):
					dst.track_insert_key(ni, knot_unmap(src.track_get_key_time(tr, ki) / L, k) * L, src.track_get_key_value(tr, ki))
	dst.set_meta(SWING_META, true)
	return dst


## ModelDef.swing_warp·swing_knots·clip_cut·loop_end·stance_lock에 적힌 클립을 불러올 때 한 번 바꿔 끼운다(remade_clip). 같은 GLB를 여러 배우가 쓰면
## 라이브러리를 나눠 가지므로 이미 바뀐 클립(메타 표식)은 건너뛴다 — 두 번 왜곡되면 안 된다.
func _apply_swing_warp(def: ModelDef) -> void:
	if def == null or _anim == null:
		return
	var sk := _first_skeleton(_model_root)
	var sk_xf := CLIP.skeleton_xform(_model_root, sk)
	for name in def.remade_clips():
		if not _anim.has_animation(name):
			continue
		var src := _anim.get_animation(name)
		if src.has_meta(SWING_META):
			continue
		var dst := remade_clip(def, name, src, sk, sk_xf)
		if dst == null:
			push_warning("ActorVisual: %s 다시 짜기(swing_warp %s · swing_knots %s · clip_cut %s · loop_end %s · stance_lock %s)가 잘못됐다 — 원래 클립으로 둔다" % [name,
				def.swing_warp.get(name), def.swing_knots.get(name), def.clip_cut.get(name), def.loop_end.get(name), def.stance_lock.has(name)])
			continue
		var lib_name := _anim.find_animation_library(src)
		var lib := _anim.get_animation_library(lib_name)
		var key := StringName(name.trim_prefix(String(lib_name) + "/")) if String(lib_name) != "" else StringName(name)
		lib.remove_animation(key)
		lib.add_animation(key, dst)


## 이 모델의 이 클립을 불러올 때 다시 짠 모습 (#503 — 셈 본체 = ClipRemake, 여기는 ModelDef를 읽어 고르기만):
## 루프 = 머리 자르기(clip_cut 창, #513 — 겹친 첫 키) → 이음새(loop_end → loop_trim) → 디딤 발 잠금(stance_lock, 뼈대 sk가 있을 때 · 속도 = 그 클립의 walk_speed·run_speed) ·
## 단발 = 자르기(clip_cut → cut_clip, 매듭이 있으면 창 안 시간도) → 시간 왜곡(매듭·칸 다섯 → warp_knots) → 골반 자리 맞춤(root_align, #513 — 뼈대 sk가 있을 때).
## 적힌 게 없거나 잘못 적혔으면 null(원래 클립 — 부르는 쪽이 경고).
## sk_xf = 모델 뿌리 → 스켈레톤(ClipRemake.skeleton_xform) — 잠금이 모델 앞(+Z)·옆을 뼈 공간으로 옮긴다. 게임·loco_probe·뷰어·시험이 이 한 길로 같은 클립을 본다.
static func remade_clip(def: ModelDef, name: String, src: Animation, sk: Skeleton3D = null, sk_xf: Transform3D = Transform3D.IDENTITY, fps: float = 60.0) -> Animation:
	if def == null or src == null:
		return null
	if def.loop_end.has(name) or def.stance_lock.has(name):
		var lp := src
		if def.clip_cut.has(name):
			# 루프 머리 자르기 (#513, §5.6) — Meshy 걷기·달리기는 첫 키가 둘째 키와 같아(1/30초 멈춤) 루프마다 한 칸 선다 → 창 시작을 둘째 키로
			var lc: Variant = def.clip_cut[name]
			if not (lc is Vector4) or not CLIP.cut_valid(lc, src.length):
				return null
			lp = CLIP.cut_clip(src, lc, PackedVector2Array([Vector2.ZERO, Vector2.ONE]), fps)
		if def.loop_end.has(name):
			var e := float(def.loop_end[name])
			if e <= 0.0 or e >= lp.length - 0.0005:
				return null
			lp = CLIP.loop_trim(lp, e, fps)
		if def.stance_lock.has(name):
			var sp := def.run_speed if name == def.anim_run else (def.walk_speed if name == def.anim_walk else -1.0)
			var locked: Animation = CLIP.stance_lock(lp, sk, sk_xf, sp, fps) if sk != null and sp > 0.0 else null
			if locked == null:
				return null
			lp = locked
		return lp
	var written := def.swing_knots.has(name) or def.swing_warp.has(name)
	var k := swing_knots_of(def, name)
	if written and k.is_empty():
		return null
	var out: Animation = null
	if def.clip_cut.has(name):
		var c: Variant = def.clip_cut[name]
		if not (c is Vector4) or not CLIP.cut_valid(c, src.length):
			return null
		out = CLIP.cut_clip(src, c, k if not k.is_empty() else PackedVector2Array([Vector2.ZERO, Vector2.ONE]), fps)
	elif not k.is_empty():
		out = warp_knots(src, k, fps)
	if def.root_align.has(name):
		out = CLIP.root_align(out if out != null else src, sk, sk_xf) if sk != null else null
	return out


## 히트스톱: 애니를 sec 초 멈춘다(공격자·피격자 양쪽에 걸면 "닿았다"가 몸으로 느껴진다). 겹치면 마지막 것만 유효.
func hit_stop(sec: float) -> void:
	# 클립 없는 떠다님 몸(#502)도 멈춘다 — 몸짓 층이 _stopped 동안 자세·옷자락을 세운다(클립 몸과 같게)
	if (_anim == null and _float == null) or not is_inside_tree():
		return
	if _anim:
		_anim.speed_scale = 0.0
	_stopped = true
	_hitstop_token += 1
	var tok := _hitstop_token
	if TRACE.enabled():
		TRACE.event("hitstop_start", "ActorVisual.hit_stop", self, {"seconds": TRACE.exact(sec), "token": TRACE.relative_hitstop(self, tok), "raw_token": tok, "timer_process_in_physics": false})
	get_tree().create_timer(sec, false).timeout.connect(func() -> void:   # 멈춤을 따른다 (#156) — 메뉴를 닫으면 남은 멈춤부터
		if TRACE.enabled():
			TRACE.event("hitstop_restore", "ActorVisual.hit_stop.timeout", self, {"token": TRACE.relative_hitstop(self, tok), "raw_token": tok, "current_token": TRACE.relative_hitstop(self, _hitstop_token), "raw_current_token": _hitstop_token, "applies": tok == _hitstop_token})
		if tok == _hitstop_token:
			_stopped = false
			if _anim:
				_anim.speed_scale = 0.0 if _anim_frozen else 1.0)   # 이동 배율은 다음 set_moving 틱이 다시 맞춘다. 얼어 있으면 0에 머문다 (E2)


## 피격 플래시: 보이는 메시 전부에 흰 오버레이를 sec 초 씌운다. 끝나면 상태 틴트(없으면 null)로 돌아간다 (E2 #202).
## full = 처치 일격(game_feel_v2 §3): 반투명이 아니라 **완전히 흰 실루엣**. 짧게(0.05초 ≈ 3프레임) — 죽는 순간이 사진처럼 박힌다.
func flash(sec: float = 0.08, full: bool = false) -> void:
	if not is_inside_tree():
		return
	if _flash_mat == null:
		_flash_mat = StandardMaterial3D.new()
		_flash_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_flash_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_flash_mat.albedo_color = Color(1.0, 0.97, 0.9, 0.7)
	if _flash_full_mat == null:
		_flash_full_mat = StandardMaterial3D.new()
		_flash_full_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_flash_full_mat.albedo_color = Color(1.0, 0.98, 0.94, 1.0)
	_pulse_overlay(_flash_full_mat if full else _flash_mat, sec, true)


# ---------- 상태 틴트 · 빙결 멈춤 (D-081 E2 #202, elements_v2 §6·§7.2) ----------
## 최소 표시다 — 한기 = 옅은 청 · 빙결 = 청백 + 애니 멈춤 · 화상 = 틱마다 주황 깜빡. 서리 결정·불씨 같은 제대로 된 상태 이펙트는 E6(#206).
## 배우(Enemy·PlayerCombat)가 상태가 바뀔 때 색만 넘긴다 — 색·세기는 core/status_effects.gd의 TINT_*.

## 상태 틴트 (알파 0 = 끔). 외곽선 껍데기·검광 리본은 빼고 몸·무기·칼집만 — 외곽선까지 칠하면 실루엣이 번진다.
## 플래시·깜빡임 중에 바뀌면 그것이 끝날 때 입는다.
func set_tint(c: Color) -> void:
	if c.a <= 0.0:
		_tint_mat = null
	else:
		if _tint_mat == null:
			_tint_mat = _unshaded_overlay(c)
		_tint_mat.albedo_color = c
	if not _overlay_busy:
		_restore_overlays()


## 지금 입은 틴트 색 (없으면 알파 0) — e2e가 읽는다.
func tint_color() -> Color:
	return _tint_mat.albedo_color if _tint_mat != null else Color(0, 0, 0, 0)


## 짧은 색 깜빡임 (화상 틱 — 주황). 플래시와 같은 길이라 겹치면 나중 것이 이기고, 끝나면 상태 틴트로 돌아간다. 외곽선은 안 칠한다.
func blink(c: Color, sec: float) -> void:
	if not is_inside_tree():
		return
	if _blink_mat == null:
		_blink_mat = _unshaded_overlay(c)
	_blink_mat.albedo_color = c
	_pulse_overlay(_blink_mat, sec, false)


## 빙결 — 애니를 지금 자세로 세운다(배율 0), 풀면 1(히트스톱 중이면 그것이 풀 때). 단발 동작·이동 배율·히트스톱이 얼어 있는 동안 배율을 올리지 않는다.
func set_anim_frozen(on: bool) -> void:
	_anim_frozen = on
	if _anim:
		_anim.speed_scale = 0.0 if (on or _stopped) else 1.0


func is_anim_frozen() -> bool:
	return _anim_frozen


## 상태 표시를 한 번에 걷는다 (죽음): 틴트·애니 멈춤, 진행 중인 플래시·깜빡임까지 끊는다 —
## 곧 굳혀 복제할 몸(두 동강 사본은 material_overlay까지 복사한다)에 주황·청이 남지 않게.
func clear_status_look() -> void:
	_tint_mat = null
	_flash_token += 1
	_overlay_busy = false
	_restore_overlays()
	set_anim_frozen(false)


## 오버레이를 sec 초 씌웠다 걷는다 (플래시·깜빡임 공용). all = 보이는 메시 전부(외곽선·검광까지 — 처치 흰 실루엣), 아니면 몸·무기만.
## 겹치면 나중 것만 끝을 맺는다 — 끝날 땐 **몸 전부**를 상태 틴트(없으면 null)로 되돌려, 앞 것의 대상이 더 넓었어도 남는 게 없다.
func _pulse_overlay(mat: Material, sec: float, all: bool) -> void:
	_flash_token += 1
	var tok := _flash_token
	_overlay_busy = true
	for mi in find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		if m.visible and (all or _tintable(m)):
			_set_overlay(m, mat)
	get_tree().create_timer(sec, false).timeout.connect(func() -> void:   # 멈춤을 따른다 (#156) — Esc 메뉴 동안 흰 번쩍임이 걷히지 않게
		if tok != _flash_token:
			return
		_overlay_busy = false
		_restore_overlays())


## 몸 전부를 쉬는 오버레이로 — 틴트가 있으면 칠할 수 있는 메시에 틴트, 나머지(와 틴트가 없으면 전부)는 null. 숨은 메시도(나중에 보여도 맞게).
func _restore_overlays() -> void:
	for mi in find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		_set_overlay(m, _tint_mat if (_tint_mat != null and _tintable(m)) else null)


## 겉칠 한 메시 — 옷자락 물결 재질을 입은 메시(#502)는 물결 재질 안에서(robe_overlay — material_overlay는 물결을 안 타 옷자락 끝에서 어긋난다), 그 밖은 material_overlay.
func _set_overlay(m: MeshInstance3D, mat: Material) -> void:
	if _float == null or not _float.set_overlay(m, mat):
		m.material_overlay = mat


## 틴트를 입힐 메시인가 — 외곽선 껍데기(_Outline)·검광 리본은 뺀다.
func _tintable(m: MeshInstance3D) -> bool:
	return m != _trail and not String(m.name).ends_with("_Outline")


static func _unshaded_overlay(c: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.albedo_color = c
	return m


## 공격 클립 고르기: 2개 이상이면 무작위, 직전 것과 다른 클립.
func _pick_attack() -> String:
	if _attack_clips.is_empty():
		return ""
	var n := _attack_clips[0]
	if _attack_clips.size() > 1:
		n = _attack_clips[randi() % _attack_clips.size()]
		if n == _last_attack:
			n = _attack_clips[(_attack_clips.find(n) + 1) % _attack_clips.size()]
	_last_attack = n
	return n


func _len_of(n: String) -> float:
	return _anim.get_animation(n).length if (_anim and n != "" and _anim.has_animation(n)) else 0.0


func _play_name(n: String, speed: float, blend: float = BLEND) -> void:
	_current = n
	last_blend = blend
	_anim.speed_scale = 0.0 if (_stopped or _anim_frozen) else 1.0   # 이동 배율은 단발 동작에 섞지 않되, 히트스톱·빙결 중이면 멈춤 유지
	_anim.play(n, blend, speed)
	_anim.seek(0.0, true)


## 사망. 반환 = 클립 길이(초, 없으면 0) — 배우가 그만큼 기다렸다가 사라진다.
func play_die() -> float:
	_dead = true
	var dur := clip_length("die")
	if dur > 0.0:
		_play("die", true)
	return dur


func revive() -> void:
	_dead = false
	_busy_until = 0.0
	_committed = false
	_current = ""
	reset_chain()
	if _float != null:
		_float.reset_motion(self)
	_play("idle")


# ---------- 떠다님 몸짓 (#502, monster_motion_v2 §3.4) — 물리 틱 · 입력 셋 · 읽기 (본체 = actors/float_motion.gd) ----------

## 떠다님 몸만 켠다(apply_node) — 몸이 이 물리 틱에 간 거리로 앞 기울기·옷자락 끌림의 빠르기를 잰다(set_moving과 따로 — AI·넉백·대본 누가 옮기든 보이는 대로).
func _physics_process(delta: float) -> void:
	if _float != null:
		_float.physics(self, delta)


## 덮치기(스침)·쏘기 튕김 — EnemyMoves._windup이 선딜(훅·한기까지 셈한 길이)과 한 대의 갈래로 부른다. play_once("attack")는 선딜 + 0.25만 받아 갈래를 모른다.
## 떠다님 층이 없거나 배율이 0이면 아무 일 없다(몸·판정은 Enemy 그대로 — 그림만 앞으로 나갔다 돌아온다, §2.1 ⑥).
func float_strike(windup: float, shot: bool) -> void:
	if _float != null and not _dead:
		_float.strike(windup, shot)


## 선딜이 끊겼다(EnemyMoves.cancel) — 덮치기를 0.2초에 제자리로.
func float_strike_cancel() -> void:
	if _float != null:
		_float.cancel_strike()


## 흩어짐 (EnemyDeath._start_scatter): 막타 멈춤(delay) 뒤 5cm 떠오르며 흩어지는 동안(sec) 흐려진다(ModelDef.float_fade).
func float_scatter(delay: float, sec: float) -> void:
	if _float != null:
		_float.scatter(self, delay, sec)


## 떠다님 층 상태 (시험·갤러리) — 기울기 · 빠르기 · 덮치기 · 움찔 · 흐려짐 · 옷자락 끌림 · 물결 시각. 층이 없으면 빈 사전.
func float_state() -> Dictionary:
	return _float.state() if _float != null else {}


# ---------- 시체 (보드 #183, game_feel_v2 §10.6) ----------
## 배우(Enemy·EnemyDeath)가 시간표(막타 멈춤 → 주저앉음·두 동강·재·박살·흩어짐 → 누움 → 가라앉음, #472)를 쥐고, 여기는 "몸이 어떻게 무너지나"만 맡는다.

## 코드로 눕히는 각(모델 X축, 라디안) — 배를 위로 거의 눕힌다. 딱 90°면 얇은 날개가 바닥 판과 같은 높이에 걸쳐 깜빡인다.
const LIE_TILT := -1.4
## 코드로 눕힌 모델의 높이(바닥에 닿게) — 처음 눕힐 때 한 번 잰다. -1 = 아직.
var _lie_h: float = -1.0


## 제자리 사망 — die 클립을 from_sec(ModelDef.die_drop_from = 무릎 대목)부터 speed배로 튼다(주저앉음 #472 = 1.45배 — 짧고 무겁게). play_die와 같이 _dead를 세운다.
## 배우가 곧바로 히트스톱(배율 0)을 걸면 섞기도 멈춰 **막타 순간의 자세가 그대로** 남고, 멈춤이 끝나면 무너지는 대목으로 섞여 든다.
## 반환 = 남은 재생 길이(초, 1배속 기준 — 클립 없으면 0).
func play_die_from(from_sec: float, speed: float = 1.0) -> float:
	_dead = true
	var n: String = _clips.get("die", "")
	var dur := _len_of(n)
	if dur <= 0.0:
		return 0.0
	var at := clampf(from_sec, 0.0, maxf(0.0, dur - 0.05))
	_current = n
	_anim.speed_scale = 0.0 if (_stopped or _anim_frozen) else 1.0
	_anim.play(n, BLEND, maxf(speed, 0.01))
	_anim.seek(at, true)
	return dur - at


## 코드로 눕히기 (k 0 = 선 자세 → 1 = 누운 자세). die 클립이 있는 모델은 클립이 눕히므로 아무것도 안 한다.
## 날짐승(코드로 띄우던 정지 메시 — 박쥐) = 날던 높이에서 배를 위로 땅까지 / 캡슐 플레이스홀더 = 뒤로 넘어간다(머리가 −Z).
func lie_down(k: float) -> void:
	if has_clip("die"):
		return
	k = clampf(k, 0.0, 1.0)
	if _model_root != null and _def != null:
		if _lie_h < 0.0:
			_lie_h = _lying_height()
		_model_root.position.y = lerpf(_def.y_offset, _lie_h, k)
		_model_root.rotation.x = lerpf(0.0, LIE_TILT, k)
		_model_root.rotation.z = 0.0
		_model_root.scale = Vector3.ONE * _def.scale   # 날갯짓 폭 맥동을 푼다
		return
	for p in _placeholders:
		var m := p as MeshInstance3D
		if m == null or not m.visible:
			continue
		var cap := m.mesh as CapsuleMesh
		var h: float = cap.height if cap else 1.0
		var r: float = cap.radius if cap else 0.3
		m.rotation.x = lerpf(0.0, -PI * 0.5, k)
		m.position.y = lerpf(h * 0.5, r, k)


## 눕힌 모델(LIE_TILT)의 가장 낮은 점이 바닥 위 0.02에 오는 높이 — 메시 AABB 여덟 모서리를 돌려 잰다(배율 포함).
func _lying_height() -> float:
	var box := AABB()
	var first := true
	for mi in _model_root.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		if m.mesh == null or m.name.ends_with("_Outline"):
			continue
		var xf := Transform3D.IDENTITY
		var n: Node = m
		while n != null and n != _model_root:
			if n is Node3D:
				xf = (n as Node3D).transform * xf
			n = n.get_parent()
		var b: AABB = xf * m.mesh.get_aabb()
		box = b if first else box.merge(b)
		first = false
	if first:
		return 0.05
	var lo := INF
	for i in 8:
		var c := box.get_endpoint(i)
		lo = minf(lo, c.y * cos(LIE_TILT) - c.z * sin(LIE_TILT))   # X축 회전 뒤 높이
	return -lo * _def.scale + 0.02


## 지금 모델 원점이 발밑보다 얼마나 떠 있나(모델 없으면 0) — e2e가 "박쥐가 땅에 떨어졌나"를 잰다.
func model_lift() -> float:
	return _model_root.position.y if _model_root != null else 0.0


# ---------- 두 동강 (보드 #184, game_feel_v2 §10.8) ----------
## 막타 순간 자세를 굳힌 몸 두 벌 — 아랫몸 = 이 노드(freeze_pose), 윗몸 = frozen_copy. 자르는 재질은 BisectFx, 시간표는 Enemy.

## 지금 자세 그대로 굳힌다 — 애니 플레이어를 끄고(곧 풀리는 히트스톱·set_moving이 다시 틀지 않게 _dead) 뼈 자세를 붙잡아 둔다.
## 굳힌 자세는 섞는 중(BLEND)이던 것까지 그대로다 — 뼈 자세를 읽어 되쓰므로 애니 플레이어를 끄는 순간 무엇을 하든 같다.
func freeze_pose() -> void:
	_dead = true
	_busy_until = _now() + 3600.0
	if _anim == null:
		return
	var sk := _first_skeleton(_model_root)
	var pose := capture_pose(sk)
	_anim.active = false
	apply_pose(sk, pose)


## 이 몸의 **굳힌 사본 한 벌** — 같은 GLB를 새로 꺼내 뼈 자세만 옮긴다(애니 없음). 외곽선 껍데기·무기 소켓까지 원래와 같게.
## 반환 = 이 노드와 같은 자리(transform)의 Node3D — 호출자가 이 노드의 형제로 붙인다. 모델이 없으면 보이는 플레이스홀더(캡슐)를 복제한다.
## 왜 duplicate()가 아닌가: 이 노드를 복제하면 스크립트까지 따라와 _ready가 모델을 또 붙이고, 애니 플레이어가 굳힌 자세를 덮는다.
func frozen_copy() -> Node3D:
	var holder := Node3D.new()
	holder.name = "FrozenCopy"
	holder.transform = transform
	if _model_root != null and _def != null and _def.exists():
		var ps := load(_def.scene_path) as PackedScene
		var copy: Node3D = ps.instantiate() as Node3D if ps else null
		if copy != null:
			copy.name = "Model"
			copy.transform = _model_root.transform
			for ap in copy.find_children("*", "AnimationPlayer", true, false):
				ap.get_parent().remove_child(ap)
				ap.free()
			holder.add_child(copy)
			var src := _first_skeleton(_model_root)
			var dst := _first_skeleton(copy)
			if src and dst and src.get_bone_count() == dst.get_bone_count():
				apply_pose(dst, capture_pose(src))
			# 외곽선 → 무기 순서(apply_node와 같게 — 무기에는 껍데기가 없다)
			if OUTLINE_WIDTH > 0.0:
				_apply_outline(copy)
			if src and dst:
				for c in src.get_children():
					if c is BoneAttachment3D:
						dst.add_child((c as Node).duplicate())
			_copy_layers(holder)
			return holder
	for p in _placeholders:
		var m := p as MeshInstance3D
		if m and m.visible:
			holder.add_child(m.duplicate())
	_copy_layers(holder)
	return holder


## 사본도 원래 몸과 같은 그리는 층(렌더 레이어)으로 — 배우에게만 켜는 비트(캐릭터 전용 조명 #191 같은)가 사본에 없으면 두 벌이 다른 빛을 받는다.
## 이 몸에 켜진 비트를 전부 모아 사본의 그리는 것 전부에 더한다(새 GLB 인스턴스라 기본값 1만 갖고 태어난다).
func _copy_layers(holder: Node) -> void:
	var bits := 0
	for vi in find_children("*", "VisualInstance3D", true, false):
		bits |= (vi as VisualInstance3D).layers
	if bits == 0:
		return
	for vi in holder.find_children("*", "VisualInstance3D", true, false):
		(vi as VisualInstance3D).layers |= bits


## 뼈 자세 [위치, 회전, 배율] 목록 (없으면 빈 배열).
static func capture_pose(sk: Skeleton3D) -> Array:
	var out: Array = []
	if sk == null:
		return out
	for b in sk.get_bone_count():
		out.append([sk.get_bone_pose_position(b), sk.get_bone_pose_rotation(b), sk.get_bone_pose_scale(b)])
	return out


static func apply_pose(sk: Skeleton3D, pose: Array) -> void:
	if sk == null:
		return
	for b in mini(pose.size(), sk.get_bone_count()):
		sk.set_bone_pose_position(b, pose[b][0])
		sk.set_bone_pose_rotation(b, pose[b][1])
		sk.set_bone_pose_scale(b, pose[b][2])


static func _first_skeleton(root: Node) -> Skeleton3D:
	if root == null:
		return null
	var list := root.find_children("*", "Skeleton3D", true, false)
	return list[0] as Skeleton3D if not list.is_empty() else null


# ---------- 내부 ----------

func _play(kind: String, restart: bool = false, blend: float = BLEND) -> void:
	if _anim == null:
		return
	var n: String = _clips.get(kind, "")
	if n == "":
		return
	if _current == n and not restart:
		return
	_current = n
	last_blend = blend
	var loco := kind == "walk" or kind == "run"
	if loco:
		_step_clip = ""   # play·seek가 그 자리에서 mixer_applied를 부를 수 있다 — 옛 위상으로 "한 바퀴 넘김"을 오판하지 않게
	_anim.play(n, blend)
	if restart:
		_anim.seek(0.0, true)
	_sync_swaps()   # 걷기 칼·시전 손 (#223) — 신호가 못 오는 경로(같은 클립 다시 틀기 등)도 여기서 맞춘다
	if loco:
		_step_clip = n   # 처음부터 튼다 → 위상 0에 적힌 디딤도 잡는다 (#178)
		_step_prev = STEP_FRESH
	if kind == "idle" and _idle_pose >= 0.0:
		_hold_idle(n)


## 지금 시각 — 손 시계(clock ≥ 0)가 아니면 게임 시계(#234): 단발 동작의 끝(_busy_until)·순환 유예가 녹화·슬로모에서도 클립과 같이 흐른다.
func _now() -> float:
	return clock if clock >= 0.0 else GameClock.now


## GLB 안의 모든 머티리얼을 nearest 필터로 (픽셀 느낌).
static func _apply_pixel_filter(root: Node) -> void:
	for mi in root.find_children("*", "MeshInstance3D", true, false):
		var m := (mi as MeshInstance3D).mesh
		if m == null:
			continue
		for i in m.get_surface_count():
			var mat := m.surface_get_material(i) as BaseMaterial3D
			if mat:
				mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST


## 클립 목록에서 동작 키에 맞는 이름을 찾는다 (§2.3: 정확 → 부분 → 동의어). 없으면 "".
## static인 이유: model_check·단위 테스트가 트리 없이 같은 규칙으로 검사한다.
static func resolve_anim(names: PackedStringArray, wanted: String, kind: String) -> String:
	if wanted != "" and names.has(wanted):
		return wanted
	var w := wanted.to_lower()
	if w != "":
		for n in names:
			if n.to_lower().contains(w):
				return n
	for syn in SYNONYMS.get(kind, []):
		for n in names:
			if n.to_lower().contains(syn):
				return n
	return ""


## 외곽선 = 법선 방향으로 부풀린 뒤집힌 껍데기(inverted hull). 스킨·본 경로를 그대로 복제하므로 같은 뼈로 움직인다.
## 왜 후처리가 아닌가: 화면 전체 외곽선 셰이더는 타일·벽에도 선을 그어 D-070의 어두운 바탕을 해친다. 배우에만 붙이는 게 싸고 안전하다.
## 호버 강조 (보드 #81). 이미 붙어 있는 외곽선 껍데기의 **색·두께만** 바꾼다 — 새 메시도, 새 드로콜도 없다.
## 외곽선이 없는 배우(플레이스홀더·정지 메시)면 조용히 아무것도 안 한다.
func set_highlight(on: bool, color: Color = Color(0.95, 0.42, 0.32)) -> void:
	for mi in find_children("*_Outline", "MeshInstance3D", true, false):
		var m := (mi as MeshInstance3D).material_override as ShaderMaterial
		if m == null:
			continue
		m.set_shader_parameter("width", OUTLINE_WIDTH * 2.6 if on else OUTLINE_WIDTH)
		m.set_shader_parameter("color", color if on else OUTLINE_COLOR)


## 변종 틴트를 입힌다 (#299, albedo_tint) — 흰색이면 아무것도 안 한다(모든 옛 모델 그대로). 외곽선 껍데기(_Outline)는 제 셰이더라 건너뛴다.
## 표면 덮기(surface_override_material)라 원본 재질·같은 GLB를 쓰는 다른 배우는 그대로 · 상태 틴트·플래시(material_overlay)와도 안 겹친다.
func _apply_albedo_tint(root: Node3D) -> void:
	if albedo_tint == Color.WHITE:
		return
	for mi in root.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		if m.mesh == null or m.name.ends_with("_Outline"):
			continue
		for si in m.mesh.get_surface_count():
			var base := m.get_active_material(si) as BaseMaterial3D
			if base == null:
				continue
			# 열쇠 = 틴트 값 그대로(str) — to_html은 1을 넘는 곱(장산범 자리표시 흰빛 ×3.9, #494)을 255로 잘라 서로 다른 틴트가 한 재질을 나눠 쓴다
			var key := "%d|%s" % [base.get_instance_id(), str(albedo_tint)]
			var tinted: BaseMaterial3D = _tinted.get(key)
			if tinted == null:
				tinted = base.duplicate() as BaseMaterial3D
				tinted.albedo_color = base.albedo_color * albedo_tint
				_tinted[key] = tinted
			m.set_surface_override_material(si, tinted)


func _apply_outline(root: Node3D) -> void:
	for mi in root.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		if m == null or m.mesh == null or not m.visible or m.name.ends_with("_Outline"):
			continue
		var hull := m.duplicate() as MeshInstance3D
		hull.name = m.name + "_Outline"
		hull.material_override = _outline_material()
		hull.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		m.get_parent().add_child(hull)


## 껍데기 부풀리기 한 줄 (#233) — **두께 = 월드 단위**. `VERTEX += NORMAL * width`만 하면 width가 메시 로컬 단위라 모델 스케일에 딸려간다:
## Meshy·Blender 내보내기 Armature 0.01이면 1/100(카드 #233의 발견 — 지금 에셋은 전부 Tripo v2 스케일 1이라 해당 없음), ModelDef.scale(박쥐 0.63·흑랑 2.2)·
## 정예 몸집(×1.1·×1.2)도 그대로 곱해졌다. MODEL_MATRIX 세 축 길이 평균(= 모델 스케일)으로 나눠 넣으면 어느 모델이든 화면에 같은 두께다.
## 두 동강(`bisect_outline.gdshader`)·먹 스러짐(`ink_dissolve_outline.gdshader`)도 **같은 줄**을 쓴다 — `tests/test_models.gd`가 세 셰이더를 대조한다.
const OUTLINE_INFLATE_GLSL := "VERTEX += NORMAL * width / max((length(MODEL_MATRIX[0].xyz) + length(MODEL_MATRIX[1].xyz) + length(MODEL_MATRIX[2].xyz)) / 3.0, 0.0001);"


## 껍데기 셰이더가 나누는 모델 스케일 — `top` 아래 `hull`까지의 누적 변환에서 세 축 길이 평균(OUTLINE_INFLATE_GLSL과 같은 식). 시험·탐침용.
static func outline_model_scale(hull: Node3D, top: Node) -> float:
	var xf := Transform3D()
	var n: Node = hull
	while n != null and n != top:
		if n is Node3D:
			xf = (n as Node3D).transform * xf
		n = n.get_parent()
	return (xf.basis.x.length() + xf.basis.y.length() + xf.basis.z.length()) / 3.0


static func _outline_material() -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = """
shader_type spatial;
render_mode cull_front, unshaded, depth_draw_opaque;
uniform float width = 0.012;
uniform vec4 color : source_color = vec4(0.05, 0.045, 0.07, 1.0);
void vertex() { %s }
void fragment() { ALBEDO = color.rgb; }
""" % OUTLINE_INFLATE_GLSL
	var mat := ShaderMaterial.new()
	mat.shader = sh
	mat.set_shader_parameter("width", OUTLINE_WIDTH)
	mat.set_shader_parameter("color", OUTLINE_COLOR)
	return mat
