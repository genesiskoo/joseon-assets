[Load] lv=1 gold=0 flags={ "opening_pending": false, "quest": { "heukrang_seal": { "state": "done" }, "heukrang_thanks": { "state": "killed" } }, "quest_log": { "history": { "heukrang_seal": [{ "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_1", "text": "도사 양반, 늦었소.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_1" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_2", "text": "할매, 술부터… 아, 분위기 아니구먼.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_2" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_3", "text": "봉인이 흔들리오. 못골 아래로 요기가 새고 있소.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_3" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_4", "text": "흑랑 굴 끝에 구미호의 수하가 자리를 잡았고, 봉밀굴 안은… 아직 잠든 것이 낫소.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_4" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_5", "text": "…또 봉인이여.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_5" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_6", "text": "도사 양반밖에 없소. 내려가 베어 주시오.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_6" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_7", "text": "술값은—", "uid": "npc/shaman/NPC_SHAMAN_OFFER_7" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_8", "text": "살아서 돌아오면 쳐 드리리다.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_8" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_9", "text": "…허. 하는 김에.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_9" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_DONE_1", "text": "…왔구려.", "uid": "npc/shaman/NPC_SHAMAN_DONE_1" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_DONE_2", "text": "끝낸 것 같기도 하고.", "uid": "npc/shaman/NPC_SHAMAN_DONE_2" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_DONE_3", "text": "봉인 기운이 달라졌소. 고맙소, 도사 양반.", "uid": "npc/shaman/NPC_SHAMAN_DONE_3" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_REPORT_1", "text": "봉인 첫 자락은 다시 여몄소. 한동안은 버틸 거요.", "uid": "npc/shaman/NPC_SHAMAN_REPORT_1" }] }, "read": { "heukrang_seal": "done/13" }, "revisions": { "heukrang_seal": 13.0 } }, "seen": { "npc/shaman/start": 2.0 }, "story": { "shaman_heal_intro": true, "shaman_offer": true } } portal=<null> wps=[]
