[Dev] flags={ "opening_pending": false, "seen": { "npc/merchant/start": 1, "npc/shaman/start": 1, "npc/jumo/start": 2 }, "story": { "merchant_met": true, "shaman_offer": true, "event/shaman_quest": true, "shaman_heal_intro": true, "jumo_met": true }, "quest_log": { "read": {  }, "history": { "heukrang_seal": [{ "uid": "npc/shaman/NPC_SHAMAN_OFFER_1", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_1", "speaker": "shaman", "name": "무당 할매", "text": "도사 양반, 늦었소. 못골이 석 달째 이 꼴이오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_2", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_2", "speaker": "doho", "name": "도호", "text": "할매, 술부터… 아, 분위기 아니구먼." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3", "speaker": "shaman", "name": "무당 할매", "text": "봉인이 흔들리오. 요사한 기운이 못골로 새고 있소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3B", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3B", "speaker": "shaman", "name": "무당 할매", "text": "꼬리 아홉 달린 천 년 묵은 여우, 구미호가 깨어났소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3C", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3C", "speaker": "shaman", "name": "무당 할매", "text": "그 수하가 들녘 너머 흑랑 굴에 들어앉았소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_4", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_4", "speaker": "shaman", "name": "무당 할매", "text": "마을 북쪽 산길 끝 봉밀굴 문 안엔 구미호가 갇혀 있소. …아직 열 때가 아니오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_5", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_5", "speaker": "doho", "name": "도호", "text": "…또 봉인이여." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_6", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_6", "speaker": "shaman", "name": "무당 할매", "text": "도사 양반밖에 없소. 장터 어귀에 주모가 있소. 길은 그 사람이 아오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_7", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_7", "speaker": "doho", "name": "도호", "text": "술값은—" }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_8", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_8", "speaker": "shaman", "name": "무당 할매", "text": "살아서 돌아오면 쳐 드리리다." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_9", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_9", "speaker": "doho", "name": "도호", "text": "…허. 하는 김에." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_1", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_1", "speaker": "jumo", "name": "주모", "text": "그나저나 도사 양반, 이 장터가 왜 닫혔는지는 아시우?" }, { "uid": "npc/jumo/NPC_JUMO_MAIN_2", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_2", "speaker": "doho", "name": "도호", "text": "봉인이 무너져서 괴질이 돈다는 건 대충 들었지." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_3", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_3", "speaker": "jumo", "name": "주모", "text": "마을 북쪽 산길 끝에 봉밀굴 문 있잖우. 돌문 말이우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_3B", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_3B", "speaker": "jumo", "name": "주모", "text": "그 문 열쇠가 세 조각으로 쪼개져서, 굴마다 하나씩 박혀 있다우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_3C", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_3C", "speaker": "jumo", "name": "주모", "text": "개가 하나, 들녘 흑랑 굴이우. 범이 하나, 고개 너머 범굴이우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_4", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_4", "speaker": "doho", "name": "도호", "text": "소문치곤 번지수까지 친절하구먼." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_4B", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_4B", "speaker": "jumo", "name": "주모", "text": "쇠 먹는 놈 뱃속에 하나는, 같은 고개 너머 쇠부리 폐광이우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_5", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_5", "speaker": "jumo", "name": "주모", "text": "목로에 앉아 있으면 소문이 다 들어오우. 값은 국물에 쳐서 받지." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_6", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_6", "speaker": "jumo", "name": "주모", "text": "열쇠를 모아 문을 열어야 이 병의 뿌리를 뽑을 수 있고, 뿌리를 뽑아야 닫힌 장터가 다시 열리지." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_7", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_7", "speaker": "doho", "name": "도호", "text": "뿌리라… 구미호 말이지." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_8", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_8", "speaker": "jumo", "name": "주모", "text": "…그 이름은 내 입에 올리기 싫수. 국물 식겠수." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_9", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_9", "speaker": "doho", "name": "도호", "text": "국물값치곤 일이 크네. 외상으로 달아 두시오." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_10", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_10", "speaker": "jumo", "name": "주모", "text": "가까운 데부터 가시구려. 동쪽 문 밖 들녘에 흑랑 굴이 있수. …국물은 식어도 외상은 안 식수." }] }, "revisions": { "heukrang_seal": 24 } }, "quest": { "heukrang_seal": { "state": "killed" }, "beomgul_seal": { "state": "accepted" }, "soeburi_seal": { "state": "accepted" }, "bongmil_gate": { "state": "accepted" }, "heukrang_thanks": { "state": "killed" } }, "boss_killed_heukrang_gul": true }
