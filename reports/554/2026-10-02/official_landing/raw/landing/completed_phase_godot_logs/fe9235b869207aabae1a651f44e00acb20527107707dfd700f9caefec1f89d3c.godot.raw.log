[Boss] killed area=heukrang_gul level=3 flags={ "opening_pending": false, "seen": { "npc/shaman/start": 1 }, "story": { "shaman_offer": true, "event/shaman_quest": true, "shaman_heal_intro": true }, "quest_log": { "read": {  }, "history": { "heukrang_seal": [{ "uid": "npc/shaman/NPC_SHAMAN_OFFER_1", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_1", "speaker": "shaman", "name": "무당 할매", "text": "도사 양반, 늦었소. 못골이 석 달째 이 꼴이오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_2", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_2", "speaker": "doho", "name": "도호", "text": "할매, 술부터… 아, 분위기 아니구먼." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3", "speaker": "shaman", "name": "무당 할매", "text": "봉인이 흔들리오. 요사한 기운이 못골로 새고 있소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3B", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3B", "speaker": "shaman", "name": "무당 할매", "text": "꼬리 아홉 달린 천 년 묵은 여우, 구미호가 깨어났소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3C", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3C", "speaker": "shaman", "name": "무당 할매", "text": "그 수하가 들녘 너머 흑랑 굴에 들어앉았소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_4", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_4", "speaker": "shaman", "name": "무당 할매", "text": "마을 북쪽 산길 끝 봉밀굴 문 안엔 구미호가 갇혀 있소. …아직 열 때가 아니오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_5", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_5", "speaker": "doho", "name": "도호", "text": "…또 봉인이여." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_6", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_6", "speaker": "shaman", "name": "무당 할매", "text": "도사 양반밖에 없소. 장터 어귀에 주모가 있소. 길은 그 사람이 아오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_7", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_7", "speaker": "doho", "name": "도호", "text": "술값은—" }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_8", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_8", "speaker": "shaman", "name": "무당 할매", "text": "살아서 돌아오면 쳐 드리리다." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_9", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_9", "speaker": "doho", "name": "도호", "text": "…허. 하는 김에." }] }, "revisions": { "heukrang_seal": 11 } }, "quest": { "heukrang_clear": { "state": "none", "left": 20, "barked": false }, "heukrang_seal": { "state": "killed" }, "heukrang_thanks": { "state": "killed" } }, "seal:boss_heukrang": 1, "boss_killed_heukrang_gul": true }
