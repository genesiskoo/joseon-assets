[Dev] flags={ "opening_pending": false, "story": { "entered/motgol": true, "merchant_met": true, "shaman_offer": true, "event/shaman_quest": true, "shaman_heal_intro": true, "jumo_met": true }, "seen": { "npc/merchant/start": 1, "npc/shaman/start": 1, "npc/jumo/start": 2 }, "quest_log": { "read": {  }, "history": { "heukrang_seal": [{ "uid": "npc/shaman/NPC_SHAMAN_OFFER_1", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_1", "speaker": "shaman", "name": "무당 할매", "text": "도사 양반, 늦었소. 못골이 석 달째 이 꼴이오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_2", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_2", "speaker": "doho", "name": "도호", "text": "할매, 술부터… 아, 분위기 아니구먼." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3", "speaker": "shaman", "name": "무당 할매", "text": "봉인이 흔들리오. 요사한 기운이 못골로 새고 있소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3B", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3B", "speaker": "shaman", "name": "무당 할매", "text": "꼬리 아홉 달린 천 년 묵은 여우, 구미호의 기운이 새는 것이오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_3C", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_3C", "speaker": "shaman", "name": "무당 할매", "text": "그 수하가 들녘 너머 흑랑 굴에 들어앉았소." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_4", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_4", "speaker": "shaman", "name": "무당 할매", "text": "마을 북쪽 산길 끝 봉밀굴 문 안엔 구미호가 갇혀 있소. …아직 열 때가 아니오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_5", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_5", "speaker": "doho", "name": "도호", "text": "…또 봉인이여." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_6", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_6", "speaker": "shaman", "name": "무당 할매", "text": "도사 양반밖에 없소. 장터 어귀에 주모가 있소. 길은 그 사람이 아오." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_7", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_7", "speaker": "doho", "name": "도호", "text": "술값은—" }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_8", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_8", "speaker": "shaman", "name": "무당 할매", "text": "살아서 돌아오면 쳐 드리리다." }, { "uid": "npc/shaman/NPC_SHAMAN_OFFER_9", "source": "npc/shaman", "static_id": "NPC_SHAMAN_OFFER_9", "speaker": "doho", "name": "도호", "text": "…허. 하는 김에." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_1", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_1", "speaker": "jumo", "name": "주모", "text": "그나저나 도사 양반, 이 장터가 왜 닫혔는지는 아시우?" }, { "uid": "npc/jumo/NPC_JUMO_MAIN_2", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_2", "speaker": "doho", "name": "도호", "text": "닫힌 장터에 국솥만 살아 있구먼. 무슨 일이우?" }, { "uid": "npc/jumo/NPC_JUMO_MAIN_3", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_3", "speaker": "jumo", "name": "주모", "text": "마을 북쪽 산길 끝 봉밀굴 문이 있수. 그 안에 이 병의 뿌리가 들었다우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_3B", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_3B", "speaker": "jumo", "name": "주모", "text": "돌문 열쇠는 세 쪽으로 흩어졌지. 굴 주인들이 하나씩 쥐고 있수." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_3C", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_3C", "speaker": "jumo", "name": "주모", "text": "들녘 흑랑 굴의 개, 고개 너머 범굴의 범." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_4", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_4", "speaker": "doho", "name": "도호", "text": "소문치곤 번지수까지 친절하구먼." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_4B", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_4B", "speaker": "jumo", "name": "주모", "text": "마지막은 쇠부리 폐광의 쇠 먹는 놈 뱃속이우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_5", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_5", "speaker": "jumo", "name": "주모", "text": "목로엔 소문이 모이는 법이우. 못 믿겠거든 길부터 살펴보시우." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_6", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_6", "speaker": "jumo", "name": "주모", "text": "열쇠 셋을 모아 북쪽 돌문을 열어 주시우. 병의 뿌리는 그 안에 있수." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_7", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_7", "speaker": "doho", "name": "도호", "text": "문 안에 뭐가 있길래?" }, { "uid": "npc/jumo/NPC_JUMO_MAIN_8", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_8", "speaker": "jumo", "name": "주모", "text": "천 년 묵은 여우가 갇혔다잖우. …그 이름은 내 입에 올리기 싫수. 국물 식겠수." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_9", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_9", "speaker": "doho", "name": "도호", "text": "국물값치곤 일이 크네. 외상으로 달아 두시오." }, { "uid": "npc/jumo/NPC_JUMO_MAIN_10", "source": "npc/jumo", "static_id": "NPC_JUMO_MAIN_10", "speaker": "jumo", "name": "주모", "text": "가까운 흑랑 굴은 동쪽 문 밖 들녘이우. 순서는 도사 양반 마음이고. …외상은 안 식수." }] }, "revisions": { "heukrang_seal": 24 } }, "quest": { "heukrang_seal": { "state": "killed" }, "beomgul_seal": { "state": "accepted" }, "soeburi_seal": { "state": "accepted" }, "bongmil_gate": { "state": "accepted" }, "heukrang_thanks": { "state": "killed" } }, "boss_killed_heukrang_gul": true }
