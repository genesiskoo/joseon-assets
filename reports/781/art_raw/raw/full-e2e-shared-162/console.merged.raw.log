[Load] lv=1 gold=0 flags={ "boss_killed_heukrang_gul": true, "opening_pending": false, "quest": { "beomgul_seal": { "state": "accepted" }, "bongmil_gate": { "state": "accepted" }, "heukrang_seal": { "state": "done" }, "heukrang_thanks": { "state": "killed" }, "soeburi_seal": { "state": "accepted" } }, "quest_log": { "history": { "heukrang_seal": [{ "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_1", "text": "도사 양반, 늦었소. 못골이 석 달째 이 꼴이오.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_1" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_2", "text": "할매, 술부터… 아, 분위기 아니구먼.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_2" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_3", "text": "봉인이 흔들리오. 요사한 기운이 못골로 새고 있소.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_3" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_3B", "text": "꼬리 아홉 달린 천 년 묵은 여우, 구미호의 기운이 새는 것이오.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_3B" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_3C", "text": "그 수하가 들녘 너머 흑랑 굴에 들어앉았소.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_3C" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_4", "text": "마을 북쪽 산길 끝 봉밀굴 문 안엔 구미호가 갇혀 있소. …아직 열 때가 아니오.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_4" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_5", "text": "…또 봉인이여.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_5" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_6", "text": "도사 양반밖에 없소. 장터 어귀에 주모가 있소. 길은 그 사람이 아오.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_6" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_7", "text": "술값은—", "uid": "npc/shaman/NPC_SHAMAN_OFFER_7" }, { "name": "무당 할매", "source": "npc/shaman", "speaker": "shaman", "static_id": "NPC_SHAMAN_OFFER_8", "text": "살아서 돌아오면 쳐 드리리다.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_8" }, { "name": "도호", "source": "npc/shaman", "speaker": "doho", "static_id": "NPC_SHAMAN_OFFER_9", "text": "…허. 하는 김에.", "uid": "npc/shaman/NPC_SHAMAN_OFFER_9" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_1", "text": "그나저나 도사 양반, 이 장터가 왜 닫혔는지는 아시우?", "uid": "npc/jumo/NPC_JUMO_MAIN_1" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_2", "text": "닫힌 장터에 국솥만 살아 있구먼. 무슨 일이우?", "uid": "npc/jumo/NPC_JUMO_MAIN_2" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_3", "text": "마을 북쪽 산길 끝 봉밀굴 문이 있수. 그 안에 이 병의 뿌리가 들었다우.", "uid": "npc/jumo/NPC_JUMO_MAIN_3" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_3B", "text": "돌문 열쇠는 세 쪽으로 흩어졌지. 굴 주인들이 하나씩 쥐고 있수.", "uid": "npc/jumo/NPC_JUMO_MAIN_3B" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_3C", "text": "들녘 흑랑 굴의 개, 고개 너머 범굴의 범.", "uid": "npc/jumo/NPC_JUMO_MAIN_3C" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_4", "text": "소문치곤 번지수까지 친절하구먼.", "uid": "npc/jumo/NPC_JUMO_MAIN_4" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_4B", "text": "마지막은 쇠부리 폐광의 쇠 먹는 놈 뱃속이우.", "uid": "npc/jumo/NPC_JUMO_MAIN_4B" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_5", "text": "목로엔 소문이 모이는 법이우. 못 믿겠거든 길부터 살펴보시우.", "uid": "npc/jumo/NPC_JUMO_MAIN_5" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_6", "text": "열쇠 셋을 모아 북쪽 돌문을 열어 주시우. 병의 뿌리는 그 안에 있수.", "uid": "npc/jumo/NPC_JUMO_MAIN_6" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_7", "text": "문 안에 뭐가 있길래?", "uid": "npc/jumo/NPC_JUMO_MAIN_7" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_8", "text": "천 년 묵은 여우가 갇혔다잖우. …그 이름은 내 입에 올리기 싫수. 국물 식겠수.", "uid": "npc/jumo/NPC_JUMO_MAIN_8" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_MAIN_9", "text": "국물값치곤 일이 크네. 외상으로 달아 두시오.", "uid": "npc/jumo/NPC_JUMO_MAIN_9" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_MAIN_10", "text": "가까운 흑랑 굴은 동쪽 문 밖 들녘이우. 순서는 도사 양반 마음이고. …외상은 안 식수.", "uid": "npc/jumo/NPC_JUMO_MAIN_10" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_1", "text": "벌써 하나 가져오셨수? 그게 열쇠우? 어디 좀…", "uid": "npc/jumo/NPC_JUMO_NEWS1_1" }, { "name": "", "source": "npc/jumo", "speaker": "", "static_id": "NPC_JUMO_NEWS1_2", "text": "조각으로 뻗던 주모의 손이 허공에서 멈춘다.", "uid": "npc/jumo/NPC_JUMO_NEWS1_2" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_3", "text": "에구, 나이 드니 손이 시려서. 도사 양반이 들고 계시우.", "uid": "npc/jumo/NPC_JUMO_NEWS1_3" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_NEWS1_4", "text": "국물 한 그릇이면 들고 다니지.", "uid": "npc/jumo/NPC_JUMO_NEWS1_4" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_HEUK", "text": "그 개는… 편히 갔수? …아니우, 괜한 소릴.", "uid": "npc/jumo/NPC_JUMO_NEWS1_HEUK" }, { "name": "주모", "source": "npc/jumo", "speaker": "jumo", "static_id": "NPC_JUMO_NEWS1_LEFT_BEOM_SOE", "text": "남은 둘은 고개 너머 정령재에 있수. 범굴이랑 쇠부리 폐광이우. 어느 쪽이 먼저든 상관없지.", "uid": "npc/jumo/NPC_JUMO_NEWS1_LEFT_BEOM_SOE" }, { "name": "도호", "source": "npc/jumo", "speaker": "doho", "static_id": "NPC_JUMO_NEWS1_END", "text": "외상이 자꾸 느는구먼. 갚을 날이 오긴 하려나.", "uid": "npc/jumo/NPC_JUMO_NEWS1_END" }] }, "read": { "beomgul_seal": "accepted/0", "bongmil_gate": "accepted/0", "heukrang_seal": "done/31", "soeburi_seal": "accepted/0" }, "revisions": { "heukrang_seal": 31.0 } }, "seen": { "npc/jumo/start": 2.0, "npc/shaman/start": 1.0 }, "story": { "entered/motgol": true, "event/shaman_quest": true, "jumo_credit_heard": true, "jumo_met": true, "jumo_seals": 1.0, "shaman_heal_intro": true, "shaman_offer": true } } portal=<null> wps=[]
